## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww]in32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Visual Studio 2017 auto generated files
Generated\ Files/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUNIT
*.VisualState.xml
TestResult.xml

# Build Results of an ATL Project
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c

# Benchmark Results
BenchmarkDotNet.Artifacts/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# StyleCop
StyleCopReport.xml

# FxCop
FxCopReport.xml

# Service Fabric Backup files
**/*.chk.xml

# RIAServices
Generated_Code/

# R#
_ReSharper*/
*.DotSettings.user

# Rider
.idea/
*.sln.iml

# JetBrains Rider
.idea
*.sln.iml

# Visual Studio Code
.vscode/

# Other
Thumbs.db
*.ds_store

# Gemini & Agent working directories
.gemini/
.spec-workflow/

# Runtime logs
crash.log

# TinyDb files & migration backups
*.db
*.db-*
*.db.*
*.migrated.bak

# Security & keys
master.key
*.key

# SSH host keys
known_hosts

# Runtime logs
logs/

