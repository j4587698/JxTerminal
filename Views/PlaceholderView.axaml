<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:JxTerminal.ViewModels"
             xmlns:c="using:JxTerminal.Converters"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="JxTerminal.Views.PlaceholderView"
             x:DataType="vm:PlaceholderViewModel">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <Border Width="76" Height="76" CornerRadius="{DynamicResource AppRadiusPill}"
                    Background="{DynamicResource LuminaStateHoverBrush}" HorizontalAlignment="Center">
                <avalonia:MaterialIcon Kind="Cone" Width="34" Height="34" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
            </Border>
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource LuminaTextPrimaryBrush}"/>
                <TextBlock Text="{c:Localize ComingSoon}" Classes="PageSubtitle" HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>

