<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:JxTerminal.ViewModels"
             xmlns:c="using:JxTerminal.Converters"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="600"
             x:Class="JxTerminal.Views.AiAssistantView"
             x:DataType="vm:AiAssistantViewModel">

    <UserControl.Styles>
        <!-- Chat bubbles: assistant left/surface, user right/accent, tool lines dimmed italic -->
        <Style Selector="Border.AiBubble">
            <Setter Property="Background" Value="{DynamicResource LuminaBackgroundBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Border.AiBubble.user">
            <Setter Property="Background" Value="{DynamicResource LuminaPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style Selector="Border.AiBubble TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LuminaTextPrimaryBrush}"/>
        </Style>
        <Style Selector="Border.AiBubble SelectableTextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LuminaTextPrimaryBrush}"/>
        </Style>
        <Style Selector="Border.AiBubble.user TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Border.AiBubble.user SelectableTextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Border.AiBubble.tool TextBlock">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
        <Style Selector="Border.AiBubble.tool SelectableTextBlock">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
    </UserControl.Styles>

    <lumina:LuminaCard CornerRadius="{DynamicResource AppRadiusLg}" Padding="0" ClipToBounds="True"
                       Background="{DynamicResource LuminaSurfaceBrush}" BorderThickness="1"
                       BorderBrush="{DynamicResource LuminaBorderDefaultBrush}">
        <Grid RowDefinitions="Auto, Auto, *, Auto">

            <!-- Header -->
            <Border Grid.Row="0" Padding="12,10" BorderBrush="{DynamicResource LuminaDividerBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <avalonia:MaterialIcon Kind="RobotOutline" Width="18" Height="18" VerticalAlignment="Center"
                                           Foreground="{DynamicResource LuminaPrimaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="{c:Localize AiAssistant}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource LuminaTextPrimaryBrush}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Classes="Ghost IconOnly Compact" Command="{Binding AnalyzeScreenCommand}"
                                ToolTip.Tip="{c:Localize AiAnalyzeScreen}">
                            <avalonia:MaterialIcon Kind="LightningBoltOutline" Width="16" Height="16" IsHitTestVisible="False"/>
                        </Button>
                        <Button Classes="Ghost IconOnly Compact" Command="{Binding ClearCommand}"
                                ToolTip.Tip="{c:Localize AiClearChat}">
                            <avalonia:MaterialIcon Kind="DeleteSweepOutline" Width="16" Height="16" IsHitTestVisible="False"/>
                        </Button>
                        <Button Classes="Ghost IconOnly Compact" Command="{Binding CloseCommand}"
                                ToolTip.Tip="{c:Localize Close}">
                            <avalonia:MaterialIcon Kind="Close" Width="16" Height="16" IsHitTestVisible="False"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Not configured banner -->
            <Border Grid.Row="1" IsVisible="{Binding !IsAiConfigured}" Margin="10,10,10,0" Padding="10,8"
                    Background="{DynamicResource LuminaWarningBgBrush}" CornerRadius="{DynamicResource AppRadiusSm}">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="{c:Localize AiNotConfigured}" TextWrapping="Wrap" FontSize="12"
                               VerticalAlignment="Center" Foreground="{DynamicResource LuminaWarningBrush}"/>
                    <Button Grid.Column="1" Classes="Ghost Compact" Content="{c:Localize AiOpenSettings}"
                            Command="{Binding OpenSettingsCommand}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Messages -->
            <ScrollViewer Grid.Row="2" x:Name="MessagesScroller" Padding="12,10"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="MessagesList" ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:AiChatMessageItem">
                            <Border Margin="0,4" Padding="10,8" CornerRadius="{DynamicResource AppRadiusMd}"
                                    Classes="AiBubble"
                                    Classes.user="{Binding IsUser}"
                                    Classes.tool="{Binding IsTool}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{c:Localize Copy}"
                                                  Command="{Binding $parent[UserControl].DataContext.CopyMessageCommand}"
                                                  CommandParameter="{Binding Content}">
                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="ContentCopy"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid ColumnDefinitions="*, Auto">
                                    <SelectableTextBlock Grid.Column="0" Text="{Binding Content}" TextWrapping="Wrap" FontSize="12.5"
                                                         SelectionBrush="{DynamicResource LuminaPrimaryBrush}"/>
                                    <Button Grid.Column="1" Classes="Ghost IconOnly Compact"
                                            VerticalAlignment="Top" Margin="6,-2,-2,0"
                                            IsVisible="{Binding !IsUser}"
                                            Command="{Binding $parent[UserControl].DataContext.CopyMessageCommand}"
                                            CommandParameter="{Binding Content}"
                                            ToolTip.Tip="{c:Localize Copy}">
                                        <avalonia:MaterialIcon Kind="ContentCopy" Width="12" Height="12" Opacity="0.55"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Input row -->
            <Border Grid.Row="3" Padding="10" BorderBrush="{DynamicResource LuminaDividerBrush}" BorderThickness="0,1,0,0">
                <Grid RowDefinitions="Auto, Auto">
                    <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="2" Margin="0,0,0,8"
                                 IsVisible="{Binding IsBusy}"/>
                    <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
                        <TextBox x:Name="InputBox" Text="{Binding InputText, Mode=TwoWay}"
                                 Classes="Rounded"
                                 IsEnabled="{Binding IsInputEnabled}"
                                 PlaceholderText="{c:Localize AiInputPlaceholder}"
                                 KeyDown="InputBox_KeyDown"
                                 AcceptsReturn="False"/>
                        <Button Grid.Column="1" Classes="Primary IconOnly" Margin="8,0,0,0"
                                Command="{Binding SendCommand}"
                                ToolTip.Tip="{c:Localize AiSend}"
                                IsEnabled="{Binding IsInputEnabled}">
                            <avalonia:MaterialIcon Kind="SendOutline" Width="16" Height="16"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </lumina:LuminaCard>
</UserControl>
