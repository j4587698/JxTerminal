<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:JxTerminal.ViewModels"
             xmlns:c="using:JxTerminal.Converters"
             mc:Ignorable="d" d:DesignWidth="380"
             x:Class="JxTerminal.Views.ChangePasswordDialog"
             x:DataType="vm:ChangePasswordViewModel">
    <StackPanel Width="360" Spacing="16">
        <TextBlock Text="{c:Localize SyncChangePasswordDesc}" Classes="Hint" TextWrapping="Wrap" Margin="0,0,0,4"/>

        <!-- Current Password -->
        <StackPanel Spacing="6">
            <TextBlock Text="{c:Localize SyncCurrentPassword}" Classes="PropLabel"/>
            <TextBox Text="{Binding CurrentPassword, Mode=TwoWay}"
                     PasswordChar="●"
                     PlaceholderText="{c:Localize SyncCurrentPassword}"/>
        </StackPanel>

        <!-- New Password -->
        <StackPanel Spacing="6">
            <TextBlock Text="{c:Localize SyncNewPassword}" Classes="PropLabel"/>
            <TextBox Text="{Binding NewPassword, Mode=TwoWay}"
                     PasswordChar="●"
                     PlaceholderText="{c:Localize SyncPasswordMinLengthHint}"/>
        </StackPanel>

        <!-- Confirm Password -->
        <StackPanel Spacing="6">
            <TextBlock Text="{c:Localize SyncConfirmNewPassword}" Classes="PropLabel"/>
            <TextBox Text="{Binding ConfirmPassword, Mode=TwoWay}"
                     PasswordChar="●"
                     PlaceholderText="{c:Localize SyncConfirmNewPassword}"/>
        </StackPanel>

        <!-- Error Message -->
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource LuminaDangerBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <!-- Action Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="{c:Localize Cancel}" Command="{Binding CancelCommand}" Classes="Ghost" IsCancel="True"/>
            <Button Content="{c:Localize SyncChangePassword}" Command="{Binding ConfirmCommand}" Classes="Primary" IsDefault="True" IsEnabled="{Binding !IsBusy}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
