<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:JxTerminal.ViewModels"
             xmlns:c="using:JxTerminal.Converters"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="450"
             x:Class="JxTerminal.Views.SftpView"
             x:DataType="vm:SftpViewModel">
  <Grid RowDefinitions="Auto, *">
      <StackPanel Orientation="Horizontal" Spacing="5" Margin="5">
          <Button Command="{Binding RefreshFilesCommand}" Content="{c:Localize Refresh}" />
          <TextBox Text="{Binding CurrentPath}" Width="200" IsReadOnly="True"/>
      </StackPanel>
      
      <DataGrid Grid.Row="1" ItemsSource="{Binding Files}"
                AutoGenerateColumns="False" IsReadOnly="True"
                GridLinesVisibility="All"
                BorderThickness="1" BorderBrush="Gray">
          <DataGrid.Columns>
              <DataGridTextColumn Header="{c:Localize Name}" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="{c:Localize FileSize}" Binding="{Binding Attributes.Size}" />
              <!-- Attrs/Permissions could be added -->
          </DataGrid.Columns>
      </DataGrid>
  </Grid>
</UserControl>
