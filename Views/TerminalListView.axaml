<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:JxTerminal.ViewModels"
             xmlns:v="using:JxTerminal.Views"
             xmlns:ctrl="using:JxTerminal.Controls"
             xmlns:c="using:JxTerminal.Converters"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="JxTerminal.Views.TerminalListView"
             x:DataType="vm:TerminalListViewModel"
             x:Name="Root">
    
    <UserControl.Resources>
        <c:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- Empty State -->
        <Grid IsVisible="{Binding !HasTabs}" RowDefinitions="*,Auto,*" ColumnDefinitions="*,Auto,*">
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="18" HorizontalAlignment="Center">
                <Border Width="84"
                        Height="84"
                        CornerRadius="{DynamicResource AppRadiusPill}"
                        Background="{DynamicResource LuminaPrimaryBgBrush}"
                        HorizontalAlignment="Center">
                    <avalonia:MaterialIcon Kind="LanDisconnect"
                                           Width="40"
                                           Height="40"
                                           Foreground="{DynamicResource LuminaPrimaryBrush}"/>
                </Border>
                <StackPanel Spacing="6">
                    <TextBlock Text="{c:Localize NoOpenConnections}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource LuminaTextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{c:Localize NoOpenConnectionsHint}"
                               Classes="PageSubtitle"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <Button Command="{Binding CreateConnectionCommand}"
                        Classes="Primary"
                        Padding="18,10"
                        CornerRadius="{DynamicResource AppRadiusSm}"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <avalonia:MaterialIcon Kind="Plus" Width="18" Height="18"/>
                        <TextBlock Text="{c:Localize NewConnection}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Content State -->
        <Grid IsVisible="{Binding HasTabs}" RowDefinitions="Auto, *">
            <!-- Tab header row -->
            <Border Height="34"
                    Padding="6,0,8,0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource LuminaDividerBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*, Auto">
                    <!-- Tab items -->
                    <ListBox Classes="Tabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                             SelectionMode="AlwaysSelected"
                             VerticalAlignment="Center"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="0"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:TerminalViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent"
                                            VerticalAlignment="Center"
                                            PointerPressed="Tab_PointerPressed"
                                            ToolTip.Tip="{Binding Title}">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{c:Localize DuplicateTab}" Command="{Binding $parent[UserControl].DataContext.DuplicateTabCommand}" CommandParameter="{Binding}"><MenuItem.Icon><avalonia:MaterialIcon Kind="ContentCopy"/></MenuItem.Icon></MenuItem>
                                            <Separator/>
                                            <MenuItem Header="{c:Localize Connect}" Command="{Binding ReconnectCommand}" IsVisible="{Binding !IsConnected}"><MenuItem.Icon><avalonia:MaterialIcon Kind="PowerPlug"/></MenuItem.Icon></MenuItem>
                                            <MenuItem Header="{c:Localize Disconnect}" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}"><MenuItem.Icon><avalonia:MaterialIcon Kind="PowerPlugOff"/></MenuItem.Icon></MenuItem>
                                            <Separator/>
                                            <MenuItem Header="{c:Localize Close}" Command="{Binding CloseCommand}"><MenuItem.Icon><avalonia:MaterialIcon Kind="Close"/></MenuItem.Icon></MenuItem>
                                            <MenuItem Header="{c:Localize CloseOtherTabs}" Command="{Binding $parent[UserControl].DataContext.CloseOtherTabsCommand}" CommandParameter="{Binding}"><MenuItem.Icon><avalonia:MaterialIcon Kind="CloseBoxMultipleOutline"/></MenuItem.Icon></MenuItem>
                                            <MenuItem Header="{c:Localize CloseTabsToLeft}" Command="{Binding $parent[UserControl].DataContext.CloseLeftTabsCommand}" CommandParameter="{Binding}"><MenuItem.Icon><avalonia:MaterialIcon Kind="ArrowLeftBox"/></MenuItem.Icon></MenuItem>
                                            <MenuItem Header="{c:Localize CloseTabsToRight}" Command="{Binding $parent[UserControl].DataContext.CloseRightTabsCommand}" CommandParameter="{Binding}"><MenuItem.Icon><avalonia:MaterialIcon Kind="ArrowRightBox"/></MenuItem.Icon></MenuItem>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <lumina:LuminaLoading Size="10" StrokeThickness="2" VerticalAlignment="Center"
                                                         IsVisible="{Binding IsConnecting}"/>
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                             Fill="{DynamicResource LuminaSuccessBrush}"
                                             IsVisible="{Binding IsConnected}"/>
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                             Fill="{DynamicResource LuminaBorderStrongBrush}"
                                             IsVisible="{Binding ShowDisconnectedDot}"/>
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                             ToolTip.Tip="{c:Localize UnseenOutput}"
                                             Classes="UnseenDot"
                                             Fill="{DynamicResource LuminaWarningBrush}"
                                             IsVisible="{Binding HasUnseenOutput}"/>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="12"
                                               FontWeight="Medium"
                                               MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                    <Button Command="{Binding CloseCommand}" Classes="TabClose"
                                            ToolTip.Tip="{c:Localize Close}">
                                        <avalonia:MaterialIcon Kind="Close" Width="11" Height="11" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <Border Width="1" Height="14" Background="{DynamicResource LuminaDividerBrush}" Margin="2,0,4,0"/>
                        <Button Classes="TabAction"
                                Command="{Binding CreateConnectionCommand}"
                                ToolTip.Tip="{c:Localize NewTab}">
                            <avalonia:MaterialIcon Kind="Plus" Width="16" Height="16" Foreground="{DynamicResource LuminaTextSecondaryBrush}"/>
                        </Button>
                        <Button Classes="TabAction" Command="{Binding ToggleAiCommand}"
                                IsEnabled="{Binding HasTabs}"
                                ToolTip.Tip="{c:Localize AiAssistantTooltip}">
                            <Panel Background="Transparent">
                                <avalonia:MaterialIcon Kind="SparklesOutline" Width="16" Height="16" Foreground="{DynamicResource LuminaTextSecondaryBrush}" IsVisible="{Binding SelectedTab.IsAiVisible, Converter={x:Static BoolConverters.Not}}"/>
                                <avalonia:MaterialIcon Kind="Sparkles" Width="16" Height="16" Foreground="{DynamicResource LuminaPrimaryBrush}" IsVisible="{Binding SelectedTab.IsAiVisible}"/>
                            </Panel>
                        </Button>
                        <Button Classes="TabAction" Command="{Binding ToggleSftpCommand}"
                                IsEnabled="{Binding HasTabs}"
                                ToolTip.Tip="{c:Localize ToggleDetailTooltip}">
                            <Panel Background="Transparent">
                                <avalonia:MaterialIcon Kind="ViewDashboardVariant" Width="16" Height="16" Foreground="{DynamicResource LuminaTextSecondaryBrush}" IsVisible="{Binding SelectedTab.IsSftpVisible, Converter={x:Static BoolConverters.Not}}"/>
                                <avalonia:MaterialIcon Kind="ViewDashboardVariant" Width="16" Height="16" Foreground="{DynamicResource LuminaPrimaryBrush}" IsVisible="{Binding SelectedTab.IsSftpVisible}"/>
                            </Panel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Content area -->
            <ContentControl Grid.Row="1" Content="{Binding SelectedTab}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="vm:TerminalViewModel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="320"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Terminal area -->
                            <!-- Terminal area: square corners — rounded corners clip text at the
                                 corners, and the block cursor/scrollbar need pixel-true edges.
                                 Small padding keeps glyphs off the border. -->
                            <ThemeVariantScope RequestedThemeVariant="Dark" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <lumina:LuminaCard Margin="12" CornerRadius="0" Padding="4,2" ClipToBounds="True" Background="{Binding Settings.BackgroundColor, Converter={StaticResource ColorToBrushConverter}}" BorderThickness="1" BorderBrush="{DynamicResource LuminaBorderDefaultBrush}">
                                <Grid ColumnDefinitions="*, Auto">
                                    <ctrl:TerminalControl x:Name="terminalControl" Controller="{Binding}"
                                                       FontFamily="{Binding Settings.FontFamily}" FontSize="{Binding Settings.FontSize, Mode=TwoWay}"
                                                       BackgroundColor="{Binding Settings.BackgroundColor}" ForegroundColor="{Binding Settings.ForegroundColor}"
                                                       EnableColors="{Binding Settings.EnableColors}" ScrollbackLines="{Binding Settings.ScrollbackLines}"
                                                       BackgroundImage="{Binding Settings.BackgroundImage}" BackgroundImageOpacity="{Binding Settings.BackgroundImageOpacity}"
                                                       ColorScheme="{Binding Settings.ColorScheme}" SelectionBackground="{Binding Settings.ColorScheme.SelectionBackground}"
                                                       CopyOnSelect="{Binding Settings.CopyOnSelect}" CursorStyle="{Binding Settings.CursorStyle}"
                                                       EnableSuggestions="{Binding Settings.EnableSuggestions}"
                                                       SearchQuery="{Binding SearchText}" SearchMatchCase="{Binding SearchMatchCase}"/>
                                    <ScrollBar Grid.Column="1" HorizontalAlignment="Right" Orientation="Vertical" Minimum="0"
                                               Maximum="{Binding #terminalControl.ScrollMaximum}" Value="{Binding #terminalControl.ScrollPosition, Mode=TwoWay}"
                                               ViewportSize="{Binding #terminalControl.ScrollViewport}" SmallChange="1" LargeChange="10"
                                               Margin="0,0,2,0"/>

                                    <!-- Find bar -->
                                    <Border Grid.ColumnSpan="2" IsVisible="{Binding IsSearchVisible}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,18,0"
                                            Background="{DynamicResource LuminaPopoverBrush}"
                                            BorderBrush="{DynamicResource LuminaBorderDefaultBrush}" BorderThickness="1"
                                            CornerRadius="{DynamicResource AppRadiusMd}" Padding="8,6"
                                            BoxShadow="{DynamicResource LuminaShadowPopup}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBox x:Name="searchBox" Width="200" Classes="Small Rounded"
                                                      Text="{Binding SearchText}"
                                                      IsVisible="{Binding IsSearchVisible}"
                                                      PlaceholderText="{c:Localize FindPlaceholder}"
                                                      Loaded="SearchBox_Loaded"
                                                      KeyDown="SearchBox_KeyDown"/>
                                            <TextBlock VerticalAlignment="Center" MinWidth="52" TextAlignment="Center"
                                                       Foreground="{DynamicResource LuminaTextTertiaryBrush}" FontSize="12">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{x:Static c:MatchCountConverter.Instance}">
                                                        <Binding Path="#terminalControl.SearchMatchOrdinal"/>
                                                        <Binding Path="#terminalControl.SearchMatchCount"/>
                                                        <Binding Path="SearchText"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <ToggleButton IsChecked="{Binding SearchMatchCase}" Classes="Ghost IconOnly Compact"
                                                          ToolTip.Tip="{c:Localize MatchCase}">
                                                <avalonia:MaterialIcon Kind="FormatLetterCase" Width="16" Height="16" IsHitTestVisible="False"/>
                                            </ToggleButton>
                                            <Button Classes="Ghost IconOnly Compact" Click="FindPrevious_Click"
                                                    ToolTip.Tip="{c:Localize PreviousMatch}">
                                                <avalonia:MaterialIcon Kind="ChevronUp" Width="16" Height="16" IsHitTestVisible="False"/>
                                            </Button>
                                            <Button Classes="Ghost IconOnly Compact" Click="FindNext_Click"
                                                    ToolTip.Tip="{c:Localize NextMatch}">
                                                <avalonia:MaterialIcon Kind="ChevronDown" Width="16" Height="16" IsHitTestVisible="False"/>
                                            </Button>
                                            <Button Classes="Ghost IconOnly Compact" Command="{Binding CloseSearchCommand}"
                                                    ToolTip.Tip="{c:Localize Close}">
                                                <avalonia:MaterialIcon Kind="Close" Width="16" Height="16" IsHitTestVisible="False"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                               
                                    <!-- Overlay / Status Message -->
                                    <Grid Grid.ColumnSpan="2" IsVisible="{Binding ShowOverlay}" Background="{DynamicResource LuminaOverlayScrimBrush}">
                                        <Border Classes="Card" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,26" BoxShadow="{DynamicResource LuminaShadowFloating}">
                                            <Panel>
                                                <!-- Connecting State -->
                                                <StackPanel Spacing="16" IsVisible="{Binding IsConnecting}" HorizontalAlignment="Center">
                                                    <lumina:LuminaLoading Size="36" StrokeThickness="3" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StatusMessage}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" MaxWidth="320" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource LuminaTextPrimaryBrush}"/>
                                                    <Button Content="{c:Localize Cancel}" Command="{Binding CloseCommand}" Classes="Secondary" HorizontalAlignment="Center" Padding="18,8"/>
                                                </StackPanel>

                                                <!-- Disconnected / Error State -->
                                                <StackPanel Spacing="16" IsVisible="{Binding !IsConnecting}" HorizontalAlignment="Center">
                                                    <avalonia:MaterialIcon Kind="AlertCircleOutline" Width="40" Height="40" Foreground="{DynamicResource LuminaWarningBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StatusMessage}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" MaxWidth="320" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource LuminaTextPrimaryBrush}"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                                        <Button Content="{c:Localize Reconnect}" Command="{Binding ReconnectCommand}" Classes="Primary" Padding="18,8"/>
                                                        <Button Content="{c:Localize Close}" Command="{Binding CloseCommand}" Classes="Secondary" Padding="18,8"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Panel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </lumina:LuminaCard>
                            </ThemeVariantScope>
                            <!-- AI assistant panel -->
                            <Grid Grid.Column="1" ColumnDefinitions="380" IsVisible="{Binding IsAiVisible}">
                                <v:AiAssistantView Grid.Column="0" Margin="0,12,12,12" DataContext="{Binding AiAssistant}"/>
                            </Grid>
                            <!-- Sidebar (fixed width; a GridSplitter here has no adjacent resizable column) -->
                            <Grid Grid.Column="2" ColumnDefinitions="420" IsVisible="{Binding IsSftpVisible}">
                                <v:SystemMonitorSidebarView Grid.Column="0" Margin="0,12,12,12"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
