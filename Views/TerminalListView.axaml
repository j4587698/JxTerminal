<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:JxTerminal.ViewModels"
             xmlns:v="using:JxTerminal.Views"
             xmlns:ctrl="using:JxTerminal.Controls"
             xmlns:c="using:JxTerminal.Converters"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="JxTerminal.Views.TerminalListView"
             x:DataType="vm:TerminalListViewModel"
             x:Name="Root">
    
    <UserControl.Resources>
        <c:FileSizeConverter x:Key="FileSizeConverter"/>
        <c:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="RadioButton.MenuTab">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Background" Background="{TemplateBinding Background}" CornerRadius="19">
                        <avalonia:MaterialIcon Kind="{TemplateBinding Content}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource LuminaTextForegroundBrush}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.MenuTab:checked /template/ Border#PART_Background">
            <Setter Property="Background" Value="{DynamicResource LuminaPrimaryBrush}"/>
        </Style>
        <Style Selector="RadioButton.MenuTab:checked /template/ avalonia|MaterialIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <Style Selector="TextBlock.PropLabel">
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.PropValue">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Modern Tabs Styling -->
        <Style Selector="ListBox.TerminalTabs">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.TerminalTabs ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="12,6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.TerminalTabs ListBoxItem:pointerover">
            <Setter Property="Background" Value="#15000000"/>
        </Style>
        <Style Selector="ListBox.TerminalTabs ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LuminaPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Empty State -->
        <Grid IsVisible="{Binding !HasTabs}" RowDefinitions="*,Auto,*" ColumnDefinitions="*,Auto,*">
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="20" HorizontalAlignment="Center">
                <avalonia:MaterialIcon Kind="LanDisconnect" Width="80" Height="80" Foreground="{DynamicResource LuminaTextForegroundBrush}" Opacity="0.2"/>
                <TextBlock Text="{c:Localize NoOpenConnections}" FontSize="28" FontWeight="Thin" Foreground="{DynamicResource LuminaTextForegroundBrush}" HorizontalAlignment="Center"/>
                <Button Command="{Binding CreateConnectionCommand}" Classes="Primary" Padding="20,12" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                         <avalonia:MaterialIcon Kind="Plus" Width="20" Height="20"/><TextBlock Text="{c:Localize NewConnection}" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Content State -->
        <Grid IsVisible="{Binding HasTabs}" RowDefinitions="Auto, *">
            <!-- Tab header row -->
            <Border Padding="12,8,12,0" Background="Transparent">
                <Grid ColumnDefinitions="*, Auto">
                    <!-- Tab items -->
                    <ListBox Classes="TerminalTabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Background="Transparent" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="2"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:TerminalViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="10" Background="Transparent">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{c:Localize DuplicateTab}" Command="{Binding $parent[UserControl].DataContext.DuplicateTabCommand}" CommandParameter="{Binding}"><MenuItem.Icon><avalonia:MaterialIcon Kind="ContentCopy"/></MenuItem.Icon></MenuItem>
                                            <Separator/>
                                            <MenuItem Header="{c:Localize Connect}" Command="{Binding ReconnectCommand}" IsVisible="{Binding !IsConnected}"><MenuItem.Icon><avalonia:MaterialIcon Kind="PowerPlug"/></MenuItem.Icon></MenuItem>
                                            <MenuItem Header="{c:Localize Disconnect}" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}"><MenuItem.Icon><avalonia:MaterialIcon Kind="PowerPlugOff"/></MenuItem.Icon></MenuItem>
                                            <Separator/>
                                            <MenuItem Header="{c:Localize Close}" Command="{Binding CloseCommand}"><MenuItem.Icon><avalonia:MaterialIcon Kind="Close"/></MenuItem.Icon></MenuItem>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <avalonia:MaterialIcon Kind="ConsoleLine" Width="16" Height="16" Foreground="{DynamicResource LuminaPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource LuminaTextForegroundBrush}"/>
                                    <Button Command="{Binding CloseCommand}" Classes="Ghost" Width="24" Height="24" Padding="0" CornerRadius="12" Margin="4,0,0,0">
                                        <avalonia:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource LuminaTextForegroundBrush}" Opacity="0.6"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- Toggle detail panel button -->
                    <Button Grid.Column="1" Classes="Ghost" Command="{Binding SelectedTab.ToggleSftpCommand}" 
                            ToolTip.Tip="{c:Localize ToggleDetail}" Padding="8" Margin="10,0,0,0" VerticalAlignment="Center" CornerRadius="8">
                        <Panel>
                            <avalonia:MaterialIcon Kind="ViewDashboardVariant" Width="20" Height="20" Foreground="{DynamicResource LuminaTextForegroundBrush}" Opacity="0.6" IsVisible="{Binding SelectedTab.IsSftpVisible, Converter={x:Static BoolConverters.Not}}"/>
                            <avalonia:MaterialIcon Kind="ViewDashboardVariant" Width="20" Height="20" Foreground="{DynamicResource LuminaPrimaryBrush}" IsVisible="{Binding SelectedTab.IsSftpVisible}"/>
                        </Panel>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Content area -->
            <ContentControl Grid.Row="1" Content="{Binding SelectedTab}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="vm:TerminalViewModel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Sidebar"/>
                            </Grid.ColumnDefinitions>
                            <!-- Terminal area -->
                            <ThemeVariantScope RequestedThemeVariant="Dark" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <lumina:LuminaCard Margin="16" CornerRadius="12" Padding="0" ClipToBounds="True" Background="{Binding Settings.BackgroundColor, Converter={StaticResource ColorToBrushConverter}}" BorderThickness="1" BorderBrush="{DynamicResource LuminaBorderBrush}">
                                <Grid ColumnDefinitions="*, Auto">
                                    <ctrl:TerminalControl x:Name="terminalControl" Controller="{Binding}" 
                                                       FontFamily="{Binding Settings.FontFamily}" FontSize="{Binding Settings.FontSize}"
                                                       BackgroundColor="{Binding Settings.BackgroundColor}" ForegroundColor="{Binding Settings.ForegroundColor}"
                                                       EnableColors="{Binding Settings.EnableColors}" ScrollbackLines="{Binding Settings.ScrollbackLines}"
                                                       BackgroundImage="{Binding Settings.BackgroundImage}" BackgroundImageOpacity="{Binding Settings.BackgroundImageOpacity}"
                                                       ColorScheme="{Binding Settings.ColorScheme}" SelectionBackground="{Binding Settings.ColorScheme.SelectionBackground}"/>
                                    <ScrollBar Grid.Column="1" HorizontalAlignment="Right" Orientation="Vertical" Minimum="0"
                                               Maximum="{Binding #terminalControl.ScrollMaximum}" Value="{Binding #terminalControl.ScrollPosition, Mode=TwoWay}"
                                               ViewportSize="{Binding #terminalControl.ScrollViewport}" SmallChange="1" LargeChange="10"
                                               Margin="0,0,2,0"/>
                                               
                                    <!-- Overlay / Status Message -->
                                    <Grid Grid.ColumnSpan="2" IsVisible="{Binding ShowOverlay}" Background="{DynamicResource LuminaSurfaceBrush}" Opacity="0.9">
                                        <lumina:LuminaCard Classes="Glass" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                                            <StackPanel Spacing="20">
                                                <avalonia:MaterialIcon Kind="AlertCircleOutline" Width="48" Height="48" Foreground="{DynamicResource LuminaWarningBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding StatusMessage}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource LuminaTextForegroundBrush}"/>
                                                <Button Content="{c:Localize Reconnect}" Command="{Binding ReconnectCommand}" Classes="Primary" HorizontalAlignment="Center" Padding="20,10"/>
                                            </StackPanel>
                                        </lumina:LuminaCard>
                                    </Grid>
                                </Grid>
                            </lumina:LuminaCard>
                            </ThemeVariantScope>
                            <!-- Sidebar -->
                            <Grid Grid.Column="1" Width="320" MinWidth="200" IsVisible="{Binding IsSftpVisible}">
                                <v:SystemMonitorSidebarView Margin="0,12,12,12"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
