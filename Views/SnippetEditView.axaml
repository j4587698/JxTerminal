<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:JxTerminal.ViewModels"
             xmlns:c="using:JxTerminal.Converters"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="300"
             x:Class="JxTerminal.Views.SnippetEditView"
             x:DataType="vm:SnippetEditViewModel">
    <UserControl.Resources>
        <c:StringLocalizationConverter x:Key="LocalizeConverter"/>
    </UserControl.Resources>
    <lumina:LuminaCard CornerRadius="{DynamicResource AppRadiusLg}" Padding="22" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="380"
                       Background="{DynamicResource LuminaSurfaceBrush}" BorderBrush="{DynamicResource LuminaBorderDefaultBrush}" BorderThickness="1">
        <StackPanel Spacing="16">
            <TextBlock Text="{Binding TitleKey, Converter={StaticResource LocalizeConverter}}" Classes="CardTitle" FontSize="17"/>

            <StackPanel Spacing="6">
                <TextBlock Text="{c:Localize SnippetName}" Classes="PropLabel" HorizontalAlignment="Left"/>
                <TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="{c:Localize SnippetNamePlaceholder}"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="{c:Localize SnippetCommand}" Classes="PropLabel" HorizontalAlignment="Left"/>
                <TextBox Text="{Binding Command, Mode=TwoWay}"
                         PlaceholderText="{c:Localize SnippetCommandPlaceholder}"
                         FontFamily="Consolas, monospace"
                         AcceptsReturn="False"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                 <Button Content="{c:Localize Cancel}" Command="{Binding CancelCommand}" Classes="Ghost"/>
                 <Button Content="{c:Localize Save}" Command="{Binding ConfirmCommand}" Classes="Primary"/>
            </StackPanel>
        </StackPanel>
    </lumina:LuminaCard>
</UserControl>
