<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:JxTerminal.ViewModels"
             xmlns:c="using:JxTerminal.Converters"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
             x:Class="JxTerminal.Views.AddConnectionView"
             x:DataType="vm:AddConnectionViewModel">
    <lumina:LuminaCard CornerRadius="{DynamicResource AppRadiusLg}" Padding="22" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="380"
                       Background="{DynamicResource LuminaSurfaceBrush}" BorderBrush="{DynamicResource LuminaBorderDefaultBrush}" BorderThickness="1">
        <StackPanel Spacing="14">
            <TextBlock Text="{c:Localize ConnectionDetails}" Classes="CardTitle" FontSize="17"/>

            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto">
                 <TextBlock Text="{c:Localize Name}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                 <TextBox Grid.Column="1" Text="{Binding Name}" />
                 
                 <TextBlock Grid.Row="1" Text="{c:Localize Group}" VerticalAlignment="Center" Margin="0,10,10,0"/>
                 <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableGroups}" SelectedItem="{Binding SelectedGroup}" Margin="0,10,0,0" HorizontalAlignment="Stretch"/>

                 <TextBlock Grid.Row="2" Text="{c:Localize Protocol}" VerticalAlignment="Center" Margin="0,10,10,0"/>
                 <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                     <RadioButton Content="SSH" IsChecked="{Binding IsSsh, Mode=TwoWay}" />
                     <RadioButton Content="Telnet" IsChecked="{Binding IsTelnet, Mode=TwoWay}" />
                     <RadioButton Content="{c:Localize Serial}" IsChecked="{Binding IsSerial, Mode=TwoWay}" />
                 </StackPanel>
            </Grid>
            
            <Border Classes="Divider" Margin="0,4"/>

            <!-- Host/Port (SSH/Telnet) -->
            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" IsVisible="{Binding !IsSerial}">
                <TextBox Grid.Row="0" Text="{Binding Host}" PlaceholderText="{c:Localize Host}" />
                <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding Port}" Minimum="1" Maximum="65535" Margin="10,0,0,0" MinWidth="100"/>
            </Grid>

            <!-- Serial Fields -->
            <StackPanel IsVisible="{Binding IsSerial}" Spacing="10">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="{c:Localize PortName}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Command="{Binding RefreshSerialPortsCommand}" Content="{c:Localize Refresh}" Classes="Outline" />
                </Grid>
                <ComboBox ItemsSource="{Binding AvailableSerialPorts}" SelectedItem="{Binding SerialPortName}" HorizontalAlignment="Stretch" IsEditable="True" />

                <Grid ColumnDefinitions="*, 10, *" RowDefinitions="Auto, Auto, Auto, Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{c:Localize BaudRate}" Classes="PropLabel" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{c:Localize DataBits}" Classes="PropLabel" HorizontalAlignment="Left"/>
                    <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding AvailableBaudRates}" SelectedItem="{Binding BaudRate}" HorizontalAlignment="Stretch" Margin="0,3,0,8"/>
                    <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding AvailableDataBits}" SelectedItem="{Binding DataBits}" HorizontalAlignment="Stretch" Margin="0,3,0,8"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{c:Localize Parity}" Classes="PropLabel" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{c:Localize StopBits}" Classes="PropLabel" HorizontalAlignment="Left"/>
                    <ComboBox Grid.Row="3" Grid.Column="0" ItemsSource="{Binding AvailableParities}" SelectedItem="{Binding Parity}" HorizontalAlignment="Stretch" Margin="0,3,0,0"/>
                    <ComboBox Grid.Row="3" Grid.Column="2" ItemsSource="{Binding AvailableStopBits}" SelectedItem="{Binding StopBits}" HorizontalAlignment="Stretch" Margin="0,3,0,0"/>
                </Grid>

                <StackPanel Spacing="3">
                    <TextBlock Text="{c:Localize FlowControl}" Classes="PropLabel" HorizontalAlignment="Left"/>
                    <ComboBox ItemsSource="{Binding AvailableHandshakes}" SelectedItem="{Binding Handshake}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </StackPanel>

            <!-- SSH Fields -->
            <StackPanel IsVisible="{Binding IsSsh}" Spacing="10">
                <TextBox Text="{Binding Username}" PlaceholderText="{c:Localize Username}" />
                
                <TextBlock Text="{c:Localize AuthenticationMethod}" Margin="0,5,0,0"/>
                <ComboBox SelectedIndex="{Binding AuthenticationType}" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="{c:Localize Password}"/>
                    <ComboBoxItem Content="{c:Localize PrivateKey}"/>
                    <ComboBoxItem Content="{c:Localize AskInteractive}"/>
                </ComboBox>

                <TextBox Text="{Binding Password}" PlaceholderText="{c:Localize Password}" PasswordChar="*" IsVisible="{Binding IsPasswordAuth}" />
                
                <StackPanel IsVisible="{Binding IsKeyAuth}" Spacing="5">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Text="{Binding KeyFilePath}" PlaceholderText="{c:Localize KeyPath}" />
                        <Button Command="{Binding SelectKeyFileCommand}" Content="..." Margin="5,0,0,0" Classes="Outline"/>
                    </Grid>
                    <TextBox Text="{Binding Passphrase}" PlaceholderText="{c:Localize Passphrase}" PasswordChar="*" />
                </StackPanel>
                
                <TextBlock Text="{c:Localize AskPasswordTip}" IsVisible="{Binding IsAskAuth}" Classes="Hint" FontStyle="Italic"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
                <Button Command="{Binding CancelCommand}" Content="{c:Localize Cancel}" Classes="Ghost"/>
                <Button Command="{Binding SaveCommand}" Content="{c:Localize Save}" Classes="Primary"/>
            </StackPanel>
        </StackPanel>
    </lumina:LuminaCard>
</UserControl>

