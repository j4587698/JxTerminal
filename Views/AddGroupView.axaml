<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:JxTerminal.ViewModels"
             xmlns:c="using:JxTerminal.Converters"
             mc:Ignorable="d" d:DesignWidth="360"
             x:Class="JxTerminal.Views.AddGroupView"
             x:DataType="vm:AddGroupViewModel">
    <StackPanel Width="340" Spacing="16">
        <StackPanel Spacing="6">
            <TextBlock Text="{c:Localize GroupName}" Classes="PropLabel" HorizontalAlignment="Left"/>
            <TextBox Text="{Binding GroupName, Mode=TwoWay}" PlaceholderText="{c:Localize GroupNamePlaceholder}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
             <Button Content="{c:Localize Cancel}" Command="{Binding CancelCommand}" Classes="Ghost" IsCancel="True"/>
             <Button Content="{c:Localize Create}" Command="{Binding ConfirmCommand}" Classes="Primary" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</UserControl>

