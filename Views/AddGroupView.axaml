<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:JxTerminal.ViewModels"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="250"
             x:Class="JxTerminal.Views.AddGroupView"
             x:DataType="vm:AddGroupViewModel">
    <lumina:LuminaCard Classes="Glass" CornerRadius="12" Padding="24" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="300">
        <StackPanel Spacing="15">
            <TextBlock Text="Create New Group" FontSize="18" FontWeight="Bold"/>
            
            <StackPanel Spacing="5">
                <TextBlock Text="Group Name" FontWeight="SemiBold"/>
                <TextBox Text="{Binding GroupName, Mode=TwoWay}" PlaceholderText="Enter Name"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
                 <Button Content="Cancel" Command="{Binding CancelCommand}" Classes="Outline"/>
                 <Button Content="Create" Command="{Binding ConfirmCommand}" Classes="Primary"/>
            </StackPanel>
        </StackPanel>
    </lumina:LuminaCard>
</UserControl>

