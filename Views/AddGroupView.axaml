<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:JxTerminal.ViewModels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="200"
             x:Class="JxTerminal.Views.AddGroupView"
             x:DataType="vm:AddGroupViewModel">
    <StackPanel Width="300" Spacing="10" Margin="10">
        <TextBlock Text="Group Name" FontWeight="Bold"/>
        <TextBox Text="{Binding GroupName, Mode=TwoWay}" Watermark="Enter Name"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
             <Button Content="Cancel" Command="{Binding CancelCommand}" Classes="Flat"/>
             <Button Content="Create" Command="{Binding ConfirmCommand}" Classes="Accent"/>
        </StackPanel>
    </StackPanel>
</UserControl>
