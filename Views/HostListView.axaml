<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:JxTerminal.ViewModels"
             xmlns:c="using:JxTerminal.Converters"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="JxTerminal.Views.HostListView"
             x:DataType="vm:HostListViewModel"
             x:Name="Root">
    <UserControl.Resources>
        <c:StringLocalizationConverter x:Key="LocalizeConverter"/>
    </UserControl.Resources>

    <Grid ColumnDefinitions="250, *">
        <!-- Left Sidebar: Tree Navigation -->
        <Border Background="{DynamicResource SukiBackground}" BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="0,0,1,0" Padding="10,15,10,15">
            <Grid RowDefinitions="Auto, *, Auto">
                <!-- Title -->
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,0,0,20">
                    <avalonia:MaterialIcon Kind="ServerNetwork" Width="24" Height="24" Foreground="{DynamicResource SukiPrimaryColor}"/>
                    <TextBlock Text="{c:Localize HostManagement}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Tree -->
                <TreeView Grid.Row="1" ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigationItem}" SelectionMode="Single">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="vm:NavigationItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}" DataType="vm:NavigationItem">
                            <Grid ColumnDefinitions="Auto, *, Auto" Background="Transparent" Height="32">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{c:Localize Delete}" 
                                                  Command="{Binding #Root.DataContext.DeleteGroupCommand}" 
                                                  CommandParameter="{Binding Group}"
                                                  IsVisible="{Binding Group, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                  Foreground="Red">
                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="Delete"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <avalonia:MaterialIcon Kind="{Binding Icon}" Width="18" Height="18" Opacity="0.8"/>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <Border Background="{DynamicResource SukiControlBorderBrush}" 
                                        CornerRadius="10" 
                                        MinWidth="20" Height="20"
                                        Padding="4,0"
                                        Grid.Column="2" 
                                        IsVisible="{Binding Group, Converter={x:Static ObjectConverters.IsNotNull}}" 
                                        Margin="10,0,0,0">
                                     <TextBlock Text="{Binding Count}" 
                                                FontSize="10" 
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Opacity="0.8"/>
                                </Border>
                            </Grid>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                
                <Button Grid.Row="2" Command="{Binding AddGroupCommand}" Classes="Flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,10,0,0" Opacity="0.7">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <avalonia:MaterialIcon Kind="Plus" Width="18" Height="18"/>
                        <TextBlock Text="{c:Localize AddGroup}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Right Content: Host List -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *">
            <!-- Top Toolbar -->
            <Grid ColumnDefinitions="*, Auto" Margin="20">
                <!-- Search & Protocol -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBox Text="{Binding SearchText}" Watermark="{c:Localize SearchPlaceholder}" Width="250" Classes="Rounded">
                        <TextBox.InnerLeftContent>
                            <avalonia:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="10,0,0,0" Opacity="0.5"/>
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <ComboBox ItemsSource="{Binding ProtocolFilters}" SelectedItem="{Binding SelectedProtocolFilter}" Width="120" />
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <!-- Secondary Actions (Outlined for consistency) -->
                    <Button Classes="Outlined" ToolTip.Tip="{c:Localize PrivacyMode}" BorderBrush="{DynamicResource SukiBorderBrush}">
                        <avalonia:MaterialIcon Kind="EyeOffOutline" Width="20" Height="20"/>
                    </Button>
                    <Button Classes="Outlined" ToolTip.Tip="{c:Localize CloudSync}" BorderBrush="{DynamicResource SukiBorderBrush}">
                        <avalonia:MaterialIcon Kind="CloudSyncOutline" Width="20" Height="20"/>
                    </Button>
                    
                    <!-- Quick Local (Outlined, not colored) -->
                    <Button Command="{Binding QuickConnectLocalCommand}" Classes="Outlined" BorderBrush="{DynamicResource SukiBorderBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="Console" Width="16" Height="16"/>
                            <TextBlock Text="{c:Localize QuickLocal}"/>
                        </StackPanel>
                    </Button>

                    <!-- Add Connection (Primary, Filled, Colored) -->
                    <Button Command="{Binding AddConnectionCommand}" Classes="Flat Primary">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                            <TextBlock Text="{c:Localize AddConnection}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" Padding="20,0,20,20">
                <ItemsControl ItemsSource="{Binding DisplayGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Opacity="0.5" Margin="5,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Connections}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Host Card -->
                                            <Border Width="280" Margin="0,0,15,15" CornerRadius="8" Background="{DynamicResource SukiCardBackground}" BoxShadow="0 1 3 0 #15000000">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{c:Localize Edit}" 
                                                                  Command="{Binding #Root.DataContext.EditConnectionCommand}" 
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="Pencil"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{c:Localize Delete}" 
                                                                  Command="{Binding #Root.DataContext.DeleteConnectionCommand}" 
                                                                  CommandParameter="{Binding}"
                                                                  Foreground="Red">
                                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="Delete"/></MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                
                                                <Grid RowDefinitions="*, Auto" Height="130">
                                                    <Grid ColumnDefinitions="Auto, *" Margin="16">
                                                        <!-- Icon (Use Dynamic Color based on type? For now just uniform) -->
                                                        <Border Width="48" Height="48" CornerRadius="10" Background="#15808080" VerticalAlignment="Top">
                                                            <avalonia:MaterialIcon Kind="ConsoleLine" Width="24" Height="24" Opacity="0.8"/>
                                                        </Border>
                                                        
                                                        <!-- Info -->
                                                        <StackPanel Grid.Column="1" Margin="15,0,0,0" Spacing="4">
                                                            <Grid ColumnDefinitions="*, Auto">
                                                                <TextBlock Text="{Binding Host}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                                                <Border Grid.Column="1" Background="{DynamicResource SukiPrimaryColor}" CornerRadius="4" Padding="4,2" Margin="5,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Type}" FontSize="9" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Username}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{c:Localize NoMemo}" FontSize="11" Opacity="0.4" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    
                                                    <!-- Footer Action -->
                                                    <!-- Use a subtle divider line -->
                                                    <Border Grid.Row="1" BorderBrush="{DynamicResource SukiControlBorderBrush}" BorderThickness="0,1,0,0">
                                                        <Button Command="{Binding #Root.DataContext.ConnectCommand}" 
                                                                CommandParameter="{Binding}"
                                                                Classes="Flat" 
                                                                HorizontalAlignment="Stretch" 
                                                                CornerRadius="0,0,8,8"
                                                                Height="36">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" Opacity="0.8">
                                                                <avalonia:MaterialIcon Kind="LightningBolt" Width="14" Height="14"/>
                                                                <TextBlock Text="{c:Localize Connect}" FontSize="12" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>