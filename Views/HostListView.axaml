<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:JxTerminal.ViewModels"
             xmlns:c="using:JxTerminal.Converters"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="JxTerminal.Views.HostListView"
             x:DataType="vm:HostListViewModel"
             x:Name="Root">
    <UserControl.Resources>
        <c:StringLocalizationConverter x:Key="LocalizeConverter"/>
    </UserControl.Resources>



    <Grid ColumnDefinitions="248, 8, *"
          Background="Transparent"
          Margin="16,16,20,20">
        <!-- Left Sidebar: Tree Navigation -->
        <Border Grid.Column="0" Classes="Card" Padding="12">
            <Grid RowDefinitions="Auto, *, Auto">
                <!-- Title -->
                <StackPanel Orientation="Horizontal" Spacing="9" Margin="4,4,0,14">
                    <avalonia:MaterialIcon Kind="ServerNetwork" Width="18" Height="18" Foreground="{DynamicResource LuminaPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{c:Localize HostManagement}" Classes="CardTitle" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Tree -->
                <TreeView Grid.Row="1" ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigationItem}" SelectionMode="Single" Background="Transparent" Padding="0">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="vm:NavigationItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}" DataType="vm:NavigationItem">
                            <Grid ColumnDefinitions="Auto, *, Auto" Background="Transparent" Height="30">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{c:Localize Delete}"
                                                  Command="{Binding #Root.DataContext.DeleteGroupCommand}"
                                                  CommandParameter="{Binding Group}"
                                                  IsVisible="{Binding Group, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                  Foreground="{DynamicResource LuminaDangerBrush}">
                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="Delete"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Grid.ContextMenu>

                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <avalonia:MaterialIcon Kind="{Binding Icon}" Width="16" Height="16" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                                    <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource LuminaTextPrimaryBrush}"/>
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Classes="Badge"
                                        Background="{DynamicResource LuminaStateHoverBrush}"
                                        MinWidth="20"
                                        IsVisible="{Binding Group, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        Margin="10,0,0,0">
                                     <TextBlock Text="{Binding Count}"
                                                Foreground="{DynamicResource LuminaTextTertiaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <StackPanel Grid.Row="2">
                    <Border Classes="Divider" Margin="0,10"/>
                    <Button Command="{Binding AddGroupCommand}" Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <avalonia:MaterialIcon Kind="Plus" Width="16" Height="16" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                            <TextBlock Text="{c:Localize AddGroup}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource LuminaTextSecondaryBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Grid Splitter -->
        <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" MinWidth="8"/>

        <!-- Right Content: Host List -->
        <Grid Grid.Column="2" RowDefinitions="Auto, *" Margin="8,0,0,0">
            <!-- Toolbar -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding SearchText}"
                             PlaceholderText="{c:Localize SearchPlaceholder}"
                             MinWidth="200"
                             MaxWidth="320"
                             Classes="Rounded"
                             HorizontalAlignment="Stretch">
                        <TextBox.InnerLeftContent>
                            <avalonia:MaterialIcon Kind="Magnify" Width="15" Height="15" Margin="10,0,0,0" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <ComboBox ItemsSource="{Binding ProtocolFilters}" SelectedItem="{Binding SelectedProtocolFilter}" Width="128">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProtocolFilterOption">
                                <TextBlock Text="{Binding Display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="Ghost IconOnly" ToolTip.Tip="{c:Localize PrivacyMode}">
                        <avalonia:MaterialIcon Kind="EyeOffOutline" Width="18" Height="18" Foreground="{DynamicResource LuminaTextSecondaryBrush}"/>
                    </Button>
                    <Button Classes="Ghost IconOnly" ToolTip.Tip="{c:Localize CloudSync}">
                        <avalonia:MaterialIcon Kind="CloudSyncOutline" Width="18" Height="18" Foreground="{DynamicResource LuminaTextSecondaryBrush}"/>
                    </Button>
                    <Button Command="{Binding QuickConnectLocalCommand}" Classes="Outline">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <avalonia:MaterialIcon Kind="Console" Width="16" Height="16"/>
                            <TextBlock Text="{c:Localize QuickLocal}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddConnectionCommand}" Classes="Primary">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <avalonia:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                            <TextBlock Text="{c:Localize AddConnection}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Content Area -->
            <Panel Grid.Row="1">
                <ScrollViewer Padding="0,0,4,0">
                    <ItemsControl ItemsSource="{Binding DisplayGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,22">
                                <TextBlock Text="{Binding Name}" Classes="GroupTitle" Margin="2,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Connections}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Host Card -->
                                            <lumina:LuminaCard Classes="Interactive"
                                                               Width="268"
                                                               Margin="0,0,14,14"
                                                               CornerRadius="{DynamicResource AppRadiusLg}"
                                                               Padding="0"
                                                               ClipToBounds="True"
                                                               DoubleTapped="HostCard_DoubleTapped"
                                                               ToolTip.Tip="{Binding DisplayTarget}"
                                                               Background="{DynamicResource LuminaSurfaceBrush}"
                                                               BorderBrush="{DynamicResource LuminaBorderDefaultBrush}"
                                                               BorderThickness="1">
                                                <lumina:LuminaCard.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{c:Localize Edit}"
                                                                  Command="{Binding #Root.DataContext.EditConnectionCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="Pencil"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{c:Localize Delete}"
                                                                  Command="{Binding #Root.DataContext.DeleteConnectionCommand}"
                                                                  CommandParameter="{Binding}"
                                                                  Foreground="{DynamicResource LuminaDangerBrush}">
                                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="Delete"/></MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </lumina:LuminaCard.ContextMenu>

                                                <Grid RowDefinitions="*, Auto">
                                                    <Grid ColumnDefinitions="Auto, *" Margin="14">
                                                        <Border Classes="IconChip" VerticalAlignment="Top">
                                                            <avalonia:MaterialIcon Kind="{Binding IconKind}" Width="20" Height="20" Foreground="{DynamicResource LuminaPrimaryBrush}"/>
                                                        </Border>

                                                        <!-- Info -->
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3">
                                                            <Grid ColumnDefinitions="*, Auto">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource LuminaTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                <Border Grid.Column="1" Classes="Badge" Margin="6,0,0,0">
                                                                    <TextBlock Text="{Binding TypeLabel}"/>
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding DisplayTarget}" FontSize="12" Foreground="{DynamicResource LuminaTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{c:Localize NoMemo}" Classes="Hint" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Footer Action -->
                                                    <Border Grid.Row="1" BorderBrush="{DynamicResource LuminaDividerBrush}" BorderThickness="0,1,0,0">
                                                        <Button Command="{Binding #Root.DataContext.ConnectCommand}"
                                                                CommandParameter="{Binding}"
                                                                Classes="Ghost"
                                                                HorizontalAlignment="Stretch"
                                                                CornerRadius="0"
                                                                Height="36">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" TextElement.Foreground="{DynamicResource LuminaPrimaryBrush}">
                                                                <avalonia:MaterialIcon Kind="LightningBolt" Width="14" Height="14" Foreground="{DynamicResource LuminaPrimaryBrush}"/>
                                                                <TextBlock Text="{c:Localize Connect}" FontSize="12" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Border>
                                                </Grid>
                                            </lumina:LuminaCard>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"
                            IsHitTestVisible="False"
                            IsVisible="{Binding !DisplayGroups.Count}">
                    <Border Width="70" Height="70" CornerRadius="{DynamicResource AppRadiusPill}"
                            Background="{DynamicResource LuminaStateHoverBrush}" HorizontalAlignment="Center">
                        <avalonia:MaterialIcon Kind="ServerOff" Width="30" Height="30" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                    </Border>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{c:Localize NoHostsTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource LuminaTextPrimaryBrush}"/>
                        <TextBlock Text="{c:Localize NoHostsEmptyHint}" Classes="PageSubtitle" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Panel>
        </Grid>
    </Grid>
</UserControl>
