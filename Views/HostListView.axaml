<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:JxTerminal.ViewModels"
             xmlns:c="using:JxTerminal.Converters"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="JxTerminal.Views.HostListView"
             x:DataType="vm:HostListViewModel"
             x:Name="Root">
    <UserControl.Resources>
        <c:StringLocalizationConverter x:Key="LocalizeConverter"/>
        <c:ProtocolToBrushConverter x:Key="ProtocolToBrush"/>
        <c:ProtocolToBgBrushConverter x:Key="ProtocolToBgBrush"/>
        <c:PingToBrushConverter x:Key="PingToBrushConverter"/>
        <c:PingToBgBrushConverter x:Key="PingToBgBrushConverter"/>
    </UserControl.Resources>



    <Grid ColumnDefinitions="190, Auto, *"
          Background="Transparent"
          Margin="0">
        <!-- Left Sidebar: Docked Tree Navigation -->
        <Border Grid.Column="0"
                Background="{DynamicResource LuminaSurfaceBrush}"
                BorderBrush="{DynamicResource LuminaDividerBrush}"
                BorderThickness="0,0,1,0"
                Padding="12,12,10,12">
            <Grid RowDefinitions="Auto, *, Auto">
                <!-- Title -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,2,0,10">
                    <avalonia:MaterialIcon Kind="FolderMultipleOutline" Width="16" Height="16" Foreground="{DynamicResource LuminaPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{c:Localize HostManagement}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Tree -->
                <TreeView Grid.Row="1" ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigationItem}" SelectionMode="Single" Background="Transparent" Padding="0">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="vm:NavigationItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="28"/>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}" DataType="vm:NavigationItem">
                            <Grid ColumnDefinitions="Auto, *, Auto" Background="Transparent" Height="28">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{c:Localize Delete}"
                                                  Command="{Binding #Root.DataContext.DeleteGroupCommand}"
                                                  CommandParameter="{Binding Group}"
                                                  IsVisible="{Binding Group, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                  Foreground="{DynamicResource LuminaDangerBrush}">
                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="Delete"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Grid.ContextMenu>

                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <avalonia:MaterialIcon Kind="{Binding Icon}" Width="15" Height="15" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                                    <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource LuminaTextPrimaryBrush}"/>
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Classes="Badge"
                                        Background="{DynamicResource LuminaStateHoverBrush}"
                                        MinWidth="18"
                                        IsVisible="{Binding Group, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        Margin="6,0,0,0">
                                     <TextBlock Text="{Binding Count}"
                                                FontSize="10"
                                                Foreground="{DynamicResource LuminaTextTertiaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <StackPanel Grid.Row="2">
                    <Border Classes="Divider" Margin="0,8"/>
                    <Button Command="{Binding AddGroupCommand}" Classes="Ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <avalonia:MaterialIcon Kind="Plus" Width="15" Height="15" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                            <TextBlock Text="{c:Localize AddGroup}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource LuminaTextSecondaryBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Grid Splitter -->
        <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" Width="4"/>

        <!-- Right Content: Host List -->
        <Grid Grid.Column="2" RowDefinitions="Auto, *" Margin="16,14,16,14">
            <!-- Modern Top Toolbar: Search on left, Actions on right -->
            <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,14">
                <!-- Search & Protocol Filter -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="HostSearch"
                             Text="{Binding SearchText}"
                             PlaceholderText="{c:Localize SearchPlaceholder}"
                             Width="210"
                             Classes="Rounded">
                        <TextBox.InnerLeftContent>
                            <avalonia:MaterialIcon Kind="Magnify" Width="14" Height="14" Margin="8,0,0,0" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                        </TextBox.InnerLeftContent>
                    </TextBox>

                    <ComboBox ItemsSource="{Binding ProtocolFilters}" SelectedItem="{Binding SelectedProtocolFilter}" Width="120" VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProtocolFilterOption">
                                <TextBlock Text="{Binding Display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Actions: Docked Right -->
                <WrapPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding RefreshPingCommand}" Classes="Outline" Margin="0,0,8,0" ToolTip.Tip="{c:Localize RefreshPing}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <avalonia:MaterialIcon Kind="Speedometer" Width="15" Height="15"/>
                            <TextBlock Text="{c:Localize TestPing}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ImportConnectionsCommand}" Classes="Outline" Margin="0,0,8,0" ToolTip.Tip="{c:Localize ImportConnections}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <avalonia:MaterialIcon Kind="FileImportOutline" Width="15" Height="15"/>
                            <TextBlock Text="{c:Localize Import}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportConnectionsCommand}" Classes="Outline" Margin="0,0,8,0" ToolTip.Tip="{c:Localize ExportConnections}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <avalonia:MaterialIcon Kind="FileExportOutline" Width="15" Height="15"/>
                            <TextBlock Text="{c:Localize Export}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding QuickConnectLocalCommand}" Classes="Outline" Margin="0,0,8,0" ToolTip.Tip="{c:Localize QuickLocal}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <avalonia:MaterialIcon Kind="Console" Width="15" Height="15"/>
                            <TextBlock Text="{c:Localize QuickLocal}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="AddConnectionButton" Command="{Binding AddConnectionCommand}" Classes="Primary" ToolTip.Tip="{c:Localize AddConnection}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <avalonia:MaterialIcon Kind="Plus" Width="15" Height="15"/>
                            <TextBlock Text="{c:Localize AddConnection}"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>

            <!-- Content Area -->
            <Panel Grid.Row="1">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <ItemsControl ItemsSource="{Binding DisplayGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="{Binding Name}" Classes="GroupTitle" Margin="2,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Connections}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Host Card -->
                                            <lumina:LuminaCard Classes="Interactive"
                                                               Width="280"
                                                               MinHeight="142"
                                                               Margin="0,0,14,14"
                                                               CornerRadius="{DynamicResource AppRadiusMd}"
                                                               Padding="0"
                                                               ClipToBounds="True"
                                                               DoubleTapped="HostCard_DoubleTapped"
                                                               ToolTip.Tip="{Binding DisplayTarget}"
                                                               Background="{DynamicResource LuminaSurfaceBrush}"
                                                               BorderBrush="{DynamicResource LuminaBorderDefaultBrush}"
                                                               BorderThickness="1">
                                                <lumina:LuminaCard.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{c:Localize Edit}"
                                                                  Command="{Binding #Root.DataContext.EditConnectionCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="Pencil"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{c:Localize DuplicateConnection}"
                                                                  Command="{Binding #Root.DataContext.DuplicateConnectionCommand}"
                                                                  CommandParameter="{Binding}">
                                                             <MenuItem.Icon><avalonia:MaterialIcon Kind="ContentCopy"/></MenuItem.Icon>
                                                         </MenuItem>
                                                        <Separator/>
                                                        <MenuItem Header="{c:Localize Delete}"
                                                                  Command="{Binding #Root.DataContext.DeleteConnectionCommand}"
                                                                  CommandParameter="{Binding}"
                                                                  Foreground="{DynamicResource LuminaDangerBrush}">
                                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="Delete"/></MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </lumina:LuminaCard.ContextMenu>

                                                <Grid RowDefinitions="*, Auto">
                                                    <!-- Main Card Body -->
                                                    <StackPanel Grid.Row="0" Margin="14,12,14,10" Spacing="9" VerticalAlignment="Center">
                                                        <!-- Header Row: Icon, Name + Protocol Badge, and Edit button -->
                                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                                            <Border Classes="IconChip" Width="36" Height="36" VerticalAlignment="Center"
                                                                    Background="{Binding Type, Converter={StaticResource ProtocolToBgBrush}}">
                                                                <avalonia:MaterialIcon Kind="{Binding IconKind}" Width="18" Height="18"
                                                                                       Foreground="{Binding Type, Converter={StaticResource ProtocolToBrush}}"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>

                                                            <!-- Name & Protocol -->
                                                            <StackPanel Grid.Column="1" Margin="10,0,4,0" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource LuminaTextPrimaryBrush}"/>
                                                                <Border Classes="Badge" HorizontalAlignment="Left"
                                                                        Background="{Binding Type, Converter={StaticResource ProtocolToBgBrush}}">
                                                                    <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="Medium"
                                                                               Foreground="{Binding Type, Converter={StaticResource ProtocolToBrush}}"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- Edit Button on top right -->
                                                            <Button Grid.Column="2" Classes="Ghost IconOnly Compact"
                                                                    Command="{Binding #Root.DataContext.EditConnectionCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="{c:Localize Edit}"
                                                                    VerticalAlignment="Top"
                                                                    Width="26" Height="26">
                                                                <avalonia:MaterialIcon Kind="PencilOutline" Width="14" Height="14"
                                                                                       Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                                                            </Button>
                                                        </Grid>

                                                        <!-- Endpoint Address Row -->
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <avalonia:MaterialIcon Kind="LanConnect" Width="13" Height="13"
                                                                                   Foreground="{DynamicResource LuminaTextTertiaryBrush}"
                                                                                   VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding EndpointDisplay}" FontSize="12"
                                                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                                                       Foreground="{DynamicResource LuminaTextSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <!-- Metadata Badges Row: User chip + Auth chip -->
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <!-- Username Badge -->
                                                            <Border IsVisible="{Binding HasUsername}"
                                                                    Background="{DynamicResource LuminaStateHoverBrush}"
                                                                    CornerRadius="4" Padding="6,2">
                                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                    <avalonia:MaterialIcon Kind="AccountOutline" Width="11" Height="11"
                                                                                           Foreground="{DynamicResource LuminaTextTertiaryBrush}"
                                                                                           VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Username}" FontSize="11"
                                                                               Foreground="{DynamicResource LuminaTextSecondaryBrush}"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Auth Type Badge -->
                                                            <Border IsVisible="{Binding HasAuthBadge}"
                                                                    Background="{DynamicResource LuminaStateHoverBrush}"
                                                                    CornerRadius="4" Padding="6,2">
                                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                    <avalonia:MaterialIcon Kind="{Binding AuthBadgeIcon}" Width="11" Height="11"
                                                                                           Foreground="{DynamicResource LuminaTextTertiaryBrush}"
                                                                                           VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding AuthBadgeLabel}" FontSize="11"
                                                                               Foreground="{DynamicResource LuminaTextSecondaryBrush}"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Ping Latency Badge -->
                                                            <Button Command="{Binding #Root.DataContext.PingSingleCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    IsVisible="{Binding HasPing}"
                                                                    Classes="Ghost"
                                                                    Padding="6,2"
                                                                    MinHeight="0"
                                                                    Height="20"
                                                                    BorderThickness="0"
                                                                    Cursor="Hand"
                                                                    CornerRadius="4"
                                                                    Background="{Binding PingLevel, Converter={StaticResource PingToBgBrushConverter}}"
                                                                    ToolTip.Tip="{c:Localize RefreshPing}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                    <lumina:LuminaLoading Size="10" StrokeThickness="1.5"
                                                                                         IsVisible="{Binding IsPinging}"
                                                                                         VerticalAlignment="Center"/>
                                                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                                             IsVisible="{Binding !IsPinging}"
                                                                             Fill="{Binding PingLevel, Converter={StaticResource PingToBrushConverter}}"/>
                                                                    <TextBlock Text="{Binding PingDisplay}" FontSize="11" FontWeight="Medium"
                                                                               Foreground="{Binding PingLevel, Converter={StaticResource PingToBrushConverter}}"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Footer Action -->
                                                    <Border Grid.Row="1" BorderBrush="{DynamicResource LuminaDividerBrush}" BorderThickness="0,1,0,0">
                                                        <Button Command="{Binding #Root.DataContext.ConnectCommand}"
                                                                CommandParameter="{Binding}"
                                                                Classes="Ghost"
                                                                HorizontalAlignment="Stretch"
                                                                CornerRadius="0"
                                                                Height="35">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <avalonia:MaterialIcon Kind="LightningBolt" Width="13" Height="13" Foreground="{DynamicResource LuminaPrimaryBrush}"/>
                                                                <TextBlock Text="{c:Localize Connect}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LuminaPrimaryBrush}"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Border>
                                                </Grid>
                                            </lumina:LuminaCard>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"
                            IsHitTestVisible="False"
                            IsVisible="{Binding HasNoVisibleHosts}">
                    <Border Width="70" Height="70" CornerRadius="{DynamicResource AppRadiusPill}"
                            Background="{DynamicResource LuminaStateHoverBrush}" HorizontalAlignment="Center">
                        <avalonia:MaterialIcon Kind="ServerOff" Width="30" Height="30" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                    </Border>
                    <StackPanel Spacing="5">
                        <TextBlock Text="{c:Localize NoHostsTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource LuminaTextPrimaryBrush}"/>
                        <TextBlock Text="{c:Localize NoHostsEmptyHint}" Classes="PageSubtitle" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Panel>
        </Grid>
    </Grid>
</UserControl>
