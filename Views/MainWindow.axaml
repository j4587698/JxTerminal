<lumina:LuminaWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
                     xmlns:vm="using:JxTerminal.ViewModels"
                     xmlns:c="using:JxTerminal.Converters"
                     xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                     xmlns:icons="clr-namespace:Material.Icons;assembly=Material.Icons"
                     mc:Ignorable="d"
                     d:DesignWidth="1200"
                     d:DesignHeight="800"
                     x:Class="JxTerminal.Views.MainWindow"
                     x:DataType="vm:MainWindowViewModel"
                     Icon="/Assets/avalonia-logo.ico"
                     Title="{c:Localize AppName}"
                     WindowChromeMode="Extended"
                     ExtendedSystemButtonMode="Auto"
                     UseWindowGlass="True">
    <lumina:LuminaWindow.DataTemplates>
        <DataTemplate DataType="icons:MaterialIconKind">
            <avalonia:MaterialIcon Kind="{Binding}" Width="18" Height="18" />
        </DataTemplate>
    </lumina:LuminaWindow.DataTemplates>

    <lumina:LuminaWindow.KeyBindings>
        <!-- Ctrl+W / Ctrl+T are left to the shell; use Shift variants so bash keeps its bindings. -->
        <KeyBinding Gesture="Ctrl+Shift+T" Command="{Binding TerminalList.CreateConnectionCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+W" Command="{Binding TerminalList.CloseCurrentTabCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding TerminalList.SelectedTab.ToggleSearchCommand}"/>
        <KeyBinding Gesture="Ctrl+Tab" Command="{Binding TerminalList.NextTabCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding TerminalList.PreviousTabCommand}"/>
        <KeyBinding Gesture="Ctrl+PageDown" Command="{Binding TerminalList.NextTabCommand}"/>
        <KeyBinding Gesture="Ctrl+PageUp" Command="{Binding TerminalList.PreviousTabCommand}"/>
    </lumina:LuminaWindow.KeyBindings>

    <Grid>
        <lumina:LuminaShell ShellKey="Root"
                            OpenPaneLength="228"
                            IsMenuOpen="True"
                            Padding="0"
                            IsShellChromeVisible="True"
                            IsShellHeaderVisible="False"
                            AutoApplyPageMetadata="False"
                            ActiveNavigationKey="{Binding SelectedNavigationKey, Mode=TwoWay}"
                            DialogContent="{Binding DialogContent}"
                            IsDialogOpen="{Binding IsDialogOpen}">
            <lumina:LuminaShell.MenuHeader>
                <Grid ColumnDefinitions="Auto,*" Margin="14,20,14,14">
                    <Border Classes="IconChip" Width="34" Height="34">
                        <avalonia:MaterialIcon Kind="ConsoleLine"
                                               Foreground="{DynamicResource LuminaPrimaryBrush}"
                                               Width="20"
                                               Height="20" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="JxTerminal"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Foreground="{DynamicResource LuminaTextPrimaryBrush}" />
                        <TextBlock Text="{c:Localize AppTagline}"
                                   Classes="Hint"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </lumina:LuminaShell.MenuHeader>

            <lumina:LuminaShell.MenuContent>
                <lumina:LuminaNavigationView SelectedKey="{Binding SelectedNavigationKey, Mode=TwoWay}">
                    <lumina:LuminaNavigationItem NavigationKey="HostList"
                                                Header="{c:Localize HostList}"
                                                Command="{Binding NavigateToHostListCommand}" Icon="{x:Static icons:MaterialIconKind.ServerNetwork}">
                        
                    </lumina:LuminaNavigationItem>

                    <lumina:LuminaNavigationItem NavigationKey="Terminal"
                                                Header="{c:Localize Terminal}"
                                                Command="{Binding NavigateToTerminalCommand}" Icon="{x:Static icons:MaterialIconKind.ConsoleLine}">
                        
                    </lumina:LuminaNavigationItem>

                    <lumina:LuminaNavigationItem NavigationKey="Transfer"
                                                Header="{c:Localize Transfer}"
                                                Command="{Binding NavigateToPlaceholderCommand}"
                                                CommandParameter="Transfer" Icon="{x:Static icons:MaterialIconKind.FolderSwap}">
                        
                    </lumina:LuminaNavigationItem>

                    <lumina:LuminaNavigationItem NavigationKey="Snippets"
                                                Header="{c:Localize Snippets}"
                                                Command="{Binding NavigateToPlaceholderCommand}"
                                                CommandParameter="Snippets" Icon="{x:Static icons:MaterialIconKind.CodeBraces}">
                        
                    </lumina:LuminaNavigationItem>

                    <lumina:LuminaNavigationItem NavigationKey="Keys"
                                                Header="{c:Localize Keys}"
                                                Command="{Binding NavigateToPlaceholderCommand}"
                                                CommandParameter="Keys" Icon="{x:Static icons:MaterialIconKind.KeyVariant}">
                        
                    </lumina:LuminaNavigationItem>

                    <lumina:LuminaNavigationItem NavigationKey="Settings"
                                                Header="{c:Localize Settings}"
                                                Command="{Binding NavigateToSettingsCommand}" Icon="{x:Static icons:MaterialIconKind.Cog}">
                        
                    </lumina:LuminaNavigationItem>
                </lumina:LuminaNavigationView>
            </lumina:LuminaShell.MenuContent>

            <lumina:LuminaShell.MenuFooter>
                <lumina:LuminaCard Padding="10"
                                   Margin="10"
                                   Classes="Interactive"
                                   CornerRadius="{DynamicResource AppRadiusMd}"
                                   Background="{DynamicResource LuminaNavigationPaneItemBrush}"
                                   BorderBrush="{DynamicResource LuminaBorderSubtleBrush}"
                                   BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="30"
                                Height="30"
                                CornerRadius="{DynamicResource AppRadiusPill}"
                                Background="{DynamicResource LuminaPrimaryBgBrush}">
                            <avalonia:MaterialIcon Kind="Account"
                                                   Foreground="{DynamicResource LuminaPrimaryBrush}"
                                                   Width="16"
                                                   Height="16"/>
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   Text="{c:Localize Login}"
                                   FontSize="12"
                                   Foreground="{DynamicResource LuminaTextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <avalonia:MaterialIcon Grid.Column="2"
                                               Kind="ChevronRight"
                                               Width="16"
                                               Height="16"
                                               Foreground="{DynamicResource LuminaTextTertiaryBrush}"
                                               VerticalAlignment="Center"/>
                    </Grid>
                </lumina:LuminaCard>
            </lumina:LuminaShell.MenuFooter>

            <TransitioningContentControl Content="{Binding ActiveContent}"
                                         Padding="0"
                                         Margin="0"
                                         VerticalContentAlignment="Stretch"
                                         HorizontalContentAlignment="Stretch">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:00:00.180" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </lumina:LuminaShell>

        <Border Background="{DynamicResource LuminaOverlayScrimBrush}"
                IsVisible="{Binding IsBusy}">
            <Border Classes="Card"
                    Padding="34,28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="{DynamicResource LuminaShadowFloating}">
                <StackPanel HorizontalAlignment="Center" Spacing="16">
                    <lumina:LuminaLoading Size="36" StrokeThickness="3" />
                    <TextBlock Text="{c:Localize StatusConnecting}"
                               Foreground="{DynamicResource LuminaTextPrimaryBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</lumina:LuminaWindow>
