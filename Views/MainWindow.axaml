<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:suki="https://github.com/kikipoulet/SukiUI"
                 xmlns:vm="using:JxTerminal.ViewModels"
                 xmlns:v="using:JxTerminal.Views"
                 xmlns:c="using:JxTerminal.Converters"
                 xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                 mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
                 x:Class="JxTerminal.Views.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 Icon="/Assets/avalonia-logo.ico"
                 Title="{c:Localize AppName}">

    <suki:SukiWindow.Hosts>
        <suki:SukiDialogHost Manager="{Binding DialogManager}" />
    </suki:SukiWindow.Hosts>
    
    <Grid>
       <!-- Main Content (SukiSideMenu) -->

    <suki:SukiSideMenu x:Name="NavMenu"
                       ItemsSource="{Binding MenuItems}"
                       IsMenuExpanded="True"
                       SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                       UseCustomContent="True"
                       SelectionChanged="OnSelectionChanged">
        <suki:SukiSideMenu.HeaderContent>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,42,12,12">
                <avalonia:MaterialIcon Kind="ConsoleLine" Foreground="{DynamicResource SukiPrimaryColor}" Width="24" Height="24"/>
                <TextBlock Text="JxTerminal" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
            </StackPanel>
        </suki:SukiSideMenu.HeaderContent>

                        <suki:SukiSideMenu.ItemTemplate>
                            <DataTemplate DataType="vm:MenuItemViewModel">
                                <suki:SukiSideMenuItem Header="{Binding Header}" ItemsSource="{Binding Children}">
                                    <suki:SukiSideMenuItem.Icon>
                                        <avalonia:MaterialIcon Kind="{Binding IconKind}" Width="24" Height="24" />
                                    </suki:SukiSideMenuItem.Icon>
                                </suki:SukiSideMenuItem>
                            </DataTemplate>
                        </suki:SukiSideMenu.ItemTemplate>
        <suki:SukiSideMenu.FooterContent>
             <StackPanel Margin="10">
                <Button Classes="Flat" HorizontalAlignment="Stretch" Padding="5" Margin="0,10,0,0">
                    <Grid ColumnDefinitions="Auto, *">
                        <Border Width="32" Height="32" CornerRadius="16" Background="Gray" Margin="0,0,10,0">
                            <avalonia:MaterialIcon Kind="User" Foreground="White" Width="16" Height="16"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{c:Localize Login}" FontSize="10" Opacity="0.7"/>
                        </StackPanel>
                    </Grid>
                </Button>
             </StackPanel>
        </suki:SukiSideMenu.FooterContent>

        <suki:SukiSideMenu.Content>
            <TransitioningContentControl Margin="12,36,12,12" Content="{Binding ActiveContent}">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:00:00.200" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </suki:SukiSideMenu.Content>
    </suki:SukiSideMenu>
    
        <Grid Background="#80000000" IsVisible="{Binding IsBusy}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <suki:Loading /> 
                <TextBlock Text="Connecting..." Foreground="White" FontSize="20" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</suki:SukiWindow>
