<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:JxTerminal.ViewModels"
             xmlns:c="using:JxTerminal.Converters"
             xmlns:lumina="clr-namespace:LuminaUI.Controls;assembly=LuminaUI"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="800"
             x:Class="JxTerminal.Views.SystemMonitorSidebarView"
             x:Name="SidebarRoot"
             x:DataType="vm:TerminalViewModel">
    <UserControl.Styles>
        <Style Selector="lumina|LuminaCard.SidebarCard">
            <Setter Property="GlassMode" Value="Off"/>
            <Setter Property="Background" Value="{DynamicResource LuminaBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LuminaBorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource AppRadiusMd}"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="lumina|LuminaCard.Glass">
            <Setter Property="GlassMode" Value="Off"/>
            <Setter Property="Background" Value="{DynamicResource LuminaBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LuminaBorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource AppRadiusMd}"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="CornerRadius" Value="{DynamicResource AppRadiusPill}"/>
            <Setter Property="Background" Value="{DynamicResource LuminaBorderSubtleBrush}"/>
        </Style>
        <Style Selector="TextBlock.CardTitle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource LuminaTextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.MetricVal">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource LuminaTextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.MetricLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource LuminaTextSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.SubLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource LuminaTextTertiaryBrush}"/>
        </Style>
    </UserControl.Styles>

    <lumina:LuminaCard CornerRadius="{DynamicResource AppRadiusLg}" Padding="0" ClipToBounds="True" Background="{DynamicResource LuminaSurfaceBrush}" BorderThickness="1" BorderBrush="{DynamicResource LuminaBorderDefaultBrush}">
        <Grid>
            <!-- SSH Session Content -->
            <Grid RowDefinitions="Auto, *" IsVisible="{Binding IsSshSession}">
            
            <!-- Top Segmented Tabs Header -->
            <Border Margin="10,10,10,6" CornerRadius="{DynamicResource AppRadiusMd}" Background="{DynamicResource LuminaBackgroundBrush}" Padding="3">
                <Grid ColumnDefinitions="*, Auto">
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <RadioButton Classes="SegTab" Content="ViewDashboard" IsChecked="True" GroupName="Sidebar" Command="{Binding Monitor.SelectTabCommand}" CommandParameter="0" ToolTip.Tip="{c:Localize SystemOverview}"/>
                            <RadioButton Classes="SegTab" Content="Cpu64Bit" GroupName="Sidebar" Command="{Binding Monitor.SelectTabCommand}" CommandParameter="1" ToolTip.Tip="{c:Localize Processor}"/>
                            <RadioButton Classes="SegTab" Content="ExpansionCard" GroupName="Sidebar" Command="{Binding Monitor.SelectTabCommand}" CommandParameter="2" ToolTip.Tip="{c:Localize GraphicsCard}"/>
                            <RadioButton Classes="SegTab" Content="Memory" GroupName="Sidebar" Command="{Binding Monitor.SelectTabCommand}" CommandParameter="3" ToolTip.Tip="{c:Localize MemoryTitle}"/>
                            <RadioButton Classes="SegTab" Content="Harddisk" GroupName="Sidebar" Command="{Binding Monitor.SelectTabCommand}" CommandParameter="4" ToolTip.Tip="{c:Localize DiskTitle}"/>
                            <RadioButton Classes="SegTab" Content="Network" GroupName="Sidebar" Command="{Binding Monitor.SelectTabCommand}" CommandParameter="5" ToolTip.Tip="{c:Localize NetworkTitle}"/>
                            <RadioButton Classes="SegTab" Content="FolderNetwork" GroupName="Sidebar" Command="{Binding Monitor.SelectTabCommand}" CommandParameter="6" ToolTip.Tip="{c:Localize SFTP}"
                                         IsVisible="{Binding IsSshSession}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="1" Height="16" Background="{DynamicResource LuminaDividerBrush}" Margin="4,0,2,0"/>
                        <Button Command="{Binding ToggleSftpCommand}" Classes="Ghost IconOnly Compact" Width="28" Height="28" ToolTip.Tip="{c:Localize Close}">
                            <avalonia:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card Panels -->
            <Grid Grid.Row="1">
                
                <!-- 0. OVERVIEW (系统概览) -->
                <ScrollViewer IsVisible="{Binding Monitor.IsTabOverview, FallbackValue=False, TargetNullValue=False}" Padding="10,4,10,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <!-- Host Info Card -->
                        <lumina:LuminaCard Classes="SidebarCard" Padding="12,10">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{DynamicResource AppRadiusSm}"
                                        Background="{DynamicResource LuminaPrimaryBgBrush}" VerticalAlignment="Center">
                                    <avalonia:MaterialIcon Kind="Server" Width="20" Height="20" Foreground="{DynamicResource LuminaPrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Monitor.Hostname}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource LuminaTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Monitor.SystemInfo}" FontSize="11" Foreground="{DynamicResource LuminaTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <avalonia:MaterialIcon Kind="ClockOutline" Width="11" Height="11" Foreground="{DynamicResource LuminaTextTertiaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Monitor.UptimeDisplay}" FontSize="11" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2" Classes="Badge" Background="{DynamicResource LuminaSuccessBgBrush}" VerticalAlignment="Top" Padding="7,2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource LuminaSuccessBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{c:Localize Online}" FontSize="10" Foreground="{DynamicResource LuminaSuccessBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </lumina:LuminaCard>

                        <!-- Hardware Resource Meters Card -->
                        <lumina:LuminaCard Classes="SidebarCard" Padding="14,12">
                            <StackPanel Spacing="12">
                                <!-- CPU Meter -->
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <avalonia:MaterialIcon Kind="Cpu64Bit" Width="16" Height="16" Foreground="{DynamicResource LuminaWarningBrush}"/>
                                            <TextBlock Text="{c:Localize CpuUsageTitle}" Classes="MetricLabel" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Monitor.CpuCoreCountDisplay}" Classes="SubLabel" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Monitor.CpuUsage, StringFormat='{}{0:0.0}%'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource LuminaWarningBrush}"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding Monitor.CpuUsage}" Minimum="0" Maximum="100" Height="6" Foreground="{DynamicResource LuminaWarningBrush}"/>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Classes="SubLabel" TextTrimming="CharacterEllipsis" Text="{Binding Monitor.LoadDisplay}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Monitor.CpuTemp, StringFormat='{}{0:0.0}°C'}" Classes="SubLabel"
                                                   IsVisible="{Binding Monitor.HasCpuTemp}"/>
                                    </Grid>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource LuminaDividerBrush}"/>

                                <!-- RAM Meter -->
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <avalonia:MaterialIcon Kind="Memory" Width="16" Height="16" Foreground="{DynamicResource LuminaDangerBrush}"/>
                                            <TextBlock Text="{c:Localize Memory}" Classes="MetricLabel" FontWeight="SemiBold"/>
                                            <TextBlock Classes="SubLabel" VerticalAlignment="Center">
                                                <Run Text="(" /><Run Text="{Binding Monitor.MemUsed, StringFormat='{}{0:0.0} GB'}" /><Run Text=" / " /><Run Text="{Binding Monitor.MemTotal, StringFormat='{}{0:0.0} GB'}" /><Run Text=")" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Monitor.RamUsage, StringFormat='{}{0:0.0}%'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource LuminaDangerBrush}"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding Monitor.RamUsage}" Minimum="0" Maximum="100" Height="6" Foreground="{DynamicResource LuminaDangerBrush}"/>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Classes="SubLabel" Text="{Binding Monitor.MemFreeCachedDisplay}"/>
                                    </Grid>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource LuminaDividerBrush}"/>

                                <!-- Disk Meter -->
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <avalonia:MaterialIcon Kind="Harddisk" Width="16" Height="16" Foreground="{DynamicResource LuminaWarningBrush}"/>
                                            <TextBlock Text="{Binding Monitor.DiskTitle}" Classes="MetricLabel" FontWeight="SemiBold"/>
                                            <TextBlock Classes="SubLabel" VerticalAlignment="Center">
                                                <Run Text="(" /><Run Text="{Binding Monitor.DiskUsedBytes, StringFormat='{}{0:0.0} GB'}" /><Run Text=" / " /><Run Text="{Binding Monitor.DiskTotal, StringFormat='{}{0:0.0} GB'}" /><Run Text=")" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Monitor.DiskUsage, StringFormat='{}{0:0.0}%'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource LuminaWarningBrush}"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding Monitor.DiskUsage}" Minimum="0" Maximum="100" Height="6" Foreground="{DynamicResource LuminaWarningBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </lumina:LuminaCard>

                        <!-- Network Real-Time Traffic Card -->
                        <lumina:LuminaCard Classes="SidebarCard" Padding="14,12">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <avalonia:MaterialIcon Kind="LanConnect" Width="16" Height="16" Foreground="{DynamicResource LuminaPrimaryBrush}"/>
                                        <TextBlock Text="{c:Localize NetworkTitle}" Classes="CardTitle"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="Badge" Background="{DynamicResource LuminaStateHoverBrush}" Padding="6,2">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <avalonia:MaterialIcon Kind="TimerOutline" Width="12" Height="12" Foreground="{DynamicResource LuminaPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Monitor.PingStatusDisplay}" FontSize="11" Foreground="{DynamicResource LuminaPrimaryBrush}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 2-Column Speed & Total -->
                                <Grid ColumnDefinitions="*, 10, *">
                                    <!-- Download -->
                                    <Border Grid.Column="0" Background="{DynamicResource LuminaSurfaceBrush}" CornerRadius="{DynamicResource AppRadiusSm}" Padding="10,8">
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <avalonia:MaterialIcon Kind="ArrowDown" Width="14" Height="14" Foreground="{DynamicResource LuminaSuccessBrush}"/>
                                                <TextBlock Text="{c:Localize Download}" Classes="SubLabel"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Monitor.NetworkDown}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource LuminaSuccessBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Monitor.NetTotalRecvDisplay}" Classes="SubLabel" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Upload -->
                                    <Border Grid.Column="2" Background="{DynamicResource LuminaSurfaceBrush}" CornerRadius="{DynamicResource AppRadiusSm}" Padding="10,8">
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <avalonia:MaterialIcon Kind="ArrowUp" Width="14" Height="14" Foreground="{DynamicResource LuminaCyanBrush}"/>
                                                <TextBlock Text="{c:Localize Upload}" Classes="SubLabel"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Monitor.NetworkUp}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource LuminaCyanBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Monitor.NetTotalSentDisplay}" Classes="SubLabel" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Connection counts -->
                                <Grid ColumnDefinitions="*, Auto" Margin="2,0">
                                    <TextBlock Text="{Binding Monitor.TcpConnectionsDisplay}" Classes="SubLabel"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Monitor.TotalPacketsDisplay}" Classes="SubLabel"/>
                                </Grid>
                            </StackPanel>
                        </lumina:LuminaCard>
                    </StackPanel>
                </ScrollViewer>

                <!-- 1. CPU / PROCESSOR -->
                <ScrollViewer IsVisible="{Binding Monitor.IsTabProcessor, FallbackValue=False, TargetNullValue=False}" Padding="10,4,10,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <lumina:LuminaCard Classes="SidebarCard" Padding="14,12">
                            <StackPanel Spacing="12">
                                <!-- CPU Model Header -->
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border Width="32" Height="32" CornerRadius="{DynamicResource AppRadiusSm}"
                                            Background="{DynamicResource LuminaWarningBgBrush}" VerticalAlignment="Center">
                                        <avalonia:MaterialIcon Kind="Cpu64Bit" Width="18" Height="18" Foreground="{DynamicResource LuminaWarningBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Monitor.CpuModel}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource LuminaTextPrimaryBrush}"/>
                                </Grid>

                                <!-- Usage & Temp -->
                                <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Monitor.CpuUsage, StringFormat='{}{0:0.0}%'}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource LuminaWarningBrush}"/>
                                        <TextBlock Text="{c:Localize Utilization}" FontSize="12" Foreground="{DynamicResource LuminaTextTertiaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Classes="Badge" Background="{DynamicResource LuminaStateHoverBrush}" Padding="8,4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <avalonia:MaterialIcon Kind="Thermometer" Width="14" Height="14" Foreground="{DynamicResource LuminaWarningBrush}"/>
                                            <TextBlock Text="{Binding Monitor.CpuTemp, StringFormat='{}{0:0.0}°C'}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <ProgressBar Value="{Binding Monitor.CpuUsage}" Minimum="0" Maximum="100" Height="6" Foreground="{DynamicResource LuminaWarningBrush}"/>

                                <!-- Details Grid -->
                                <Border Background="{DynamicResource LuminaSurfaceBrush}" CornerRadius="{DynamicResource AppRadiusSm}" Padding="12,10">
                                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, 8, Auto">
                                        <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto, *">
                                            <TextBlock Text="{c:Localize CoreCount}" Classes="SubLabel"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Monitor.CpuCoreCount}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto, *" Margin="12,0,0,0">
                                            <TextBlock Text="{c:Localize ThreadCount}" Classes="SubLabel"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Monitor.CpuThreadCount}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto, *">
                                            <TextBlock Text="{c:Localize LoadAverage}" Classes="SubLabel"/>
                                            <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right">
                                                <Run Text="{Binding Monitor.Load1, StringFormat='{}{0:0.00}'}"/><Run Text=" / "/><Run Text="{Binding Monitor.Load5, StringFormat='{}{0:0.00}'}"/><Run Text=" / "/><Run Text="{Binding Monitor.Load15, StringFormat='{}{0:0.00}'}"/>
                                            </TextBlock>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </lumina:LuminaCard>
                        
                        <!-- Top Processes -->
                        <lumina:LuminaCard Classes="SidebarCard" Padding="14,12">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <avalonia:MaterialIcon Kind="FormatListNumbered" Width="16" Height="16" Foreground="{DynamicResource LuminaPrimaryBrush}"/>
                                    <TextBlock Text="{c:Localize TopProcesses}" Classes="CardTitle"/>
                                </StackPanel>

                                <!-- Table Header -->
                                <Border Background="{DynamicResource LuminaSurfaceBrush}" CornerRadius="{DynamicResource AppRadiusSm}" Padding="8,6">
                                    <Grid ColumnDefinitions="55, *, 65, 60">
                                        <TextBlock Grid.Column="0" Text="PID" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{c:Localize Name}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="CPU%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource LuminaTextTertiaryBrush}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="MEM%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource LuminaTextTertiaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <!-- Process Items -->
                                <ItemsControl ItemsSource="{Binding Monitor.TopProcesses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,4" CornerRadius="{DynamicResource AppRadiusSm}" Background="Transparent">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{c:Localize KillProcess}"
                                                                  Command="{Binding #SidebarRoot.DataContext.Monitor.KillProcessCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="CloseCircleOutline" Foreground="{DynamicResource LuminaWarningBrush}"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{c:Localize ForceKillProcess}"
                                                                  Command="{Binding #SidebarRoot.DataContext.Monitor.ForceKillProcessCommand}"
                                                                  CommandParameter="{Binding}"
                                                                  Foreground="{DynamicResource LuminaDangerBrush}">
                                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="SkullCrossbones" Foreground="{DynamicResource LuminaDangerBrush}"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator/>
                                                        <MenuItem Header="{c:Localize CopyPid}"
                                                                  Command="{Binding #SidebarRoot.DataContext.Monitor.CopyTextCommand}"
                                                                  CommandParameter="{Binding Pid}">
                                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="Numeric"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{c:Localize CopyProcessName}"
                                                                  Command="{Binding #SidebarRoot.DataContext.Monitor.CopyTextCommand}"
                                                                  CommandParameter="{Binding Name}">
                                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="FormatLetterCase"/></MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid ColumnDefinitions="55, *, 65, 60">
                                                    <TextBlock Grid.Column="0" Text="{Binding Pid}" FontSize="11" Foreground="{DynamicResource LuminaTextTertiaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource LuminaTextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Name}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding DisplayCpu}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LuminaWarningBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding DisplayMem}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LuminaDangerBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </lumina:LuminaCard>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2. GPU -->
                <ScrollViewer IsVisible="{Binding Monitor.IsTabGpu, FallbackValue=False, TargetNullValue=False}" Padding="10,4,10,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <lumina:LuminaCard Classes="SidebarCard" Padding="14,12" IsVisible="{Binding Monitor.GpuDetected}">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border Width="32" Height="32" CornerRadius="{DynamicResource AppRadiusSm}"
                                            Background="{DynamicResource LuminaDangerBgBrush}" VerticalAlignment="Center">
                                        <avalonia:MaterialIcon Kind="ExpansionCard" Width="18" Height="18" Foreground="{DynamicResource LuminaDangerBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Monitor.GpuModel}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Monitor.GpuUsage, StringFormat='{}{0:0.0}%'}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource LuminaDangerBrush}"/>
                                        <TextBlock Text="{c:Localize Utilization}" FontSize="12" Foreground="{DynamicResource LuminaTextTertiaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Classes="Badge" Background="{DynamicResource LuminaStateHoverBrush}" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <avalonia:MaterialIcon Kind="Flash" Width="14" Height="14" Foreground="{DynamicResource LuminaWarningBrush}"/>
                                                <TextBlock Text="{Binding Monitor.GpuPower, StringFormat='{}{0:0} W'}" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="Badge" Background="{DynamicResource LuminaStateHoverBrush}" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <avalonia:MaterialIcon Kind="Thermometer" Width="14" Height="14" Foreground="{DynamicResource LuminaDangerBrush}"/>
                                                <TextBlock Text="{Binding Monitor.GpuTemp, StringFormat='{}{0:0}°C'}" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <ProgressBar Value="{Binding Monitor.GpuUsage}" Minimum="0" Maximum="100" Height="6" Foreground="{DynamicResource LuminaDangerBrush}"/>

                                <!-- VRAM Card -->
                                <Border Background="{DynamicResource LuminaSurfaceBrush}" CornerRadius="{DynamicResource AppRadiusSm}" Padding="12,10">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Text="{c:Localize VideoMemory}" Classes="SubLabel"/>
                                            <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold">
                                                <Run Text="{Binding Monitor.GpuMemoryUsed, StringFormat='{}{0:0.1}'}"/><Run Text=" / "/><Run Text="{Binding Monitor.GpuMemoryTotal, StringFormat='{}{0:0.1} GB'}"/>
                                            </TextBlock>
                                        </Grid>
                                        <ProgressBar Value="{Binding Monitor.GpuMemoryUsed}" Maximum="{Binding Monitor.GpuMemoryTotal}" Height="4" Foreground="{DynamicResource LuminaDangerBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </lumina:LuminaCard>
                        
                        <lumina:LuminaCard Classes="SidebarCard" Padding="30" IsVisible="{Binding !Monitor.GpuDetected}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <Border Width="60" Height="60" CornerRadius="{DynamicResource AppRadiusPill}"
                                        Background="{DynamicResource LuminaStateHoverBrush}" HorizontalAlignment="Center">
                                    <avalonia:MaterialIcon Kind="ExpansionCardVariant" Width="28" Height="28" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                                </Border>
                                <TextBlock Text="{c:Localize NoNvidiaGpu}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{c:Localize InstallNvidiaDriver}" FontSize="12" Foreground="{DynamicResource LuminaTextTertiaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>
                            </StackPanel>
                        </lumina:LuminaCard>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. MEMORY -->
                <ScrollViewer IsVisible="{Binding Monitor.IsTabMemory, FallbackValue=False, TargetNullValue=False}" Padding="10,4,10,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <lumina:LuminaCard Classes="SidebarCard" Padding="14,12">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border Width="32" Height="32" CornerRadius="{DynamicResource AppRadiusSm}"
                                            Background="{DynamicResource LuminaDangerBgBrush}" VerticalAlignment="Center">
                                        <avalonia:MaterialIcon Kind="Memory" Width="18" Height="18" Foreground="{DynamicResource LuminaDangerBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{c:Localize MemoryTitle}" Classes="CardTitle" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Monitor.RamUsage, StringFormat='{}{0:0.0}%'}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource LuminaDangerBrush}"/>
                                        <TextBlock Text="{c:Localize Utilization}" FontSize="12" Foreground="{DynamicResource LuminaTextTertiaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Monitor.MemUsed, StringFormat='{}{0:0.0} GB'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource LuminaTextPrimaryBrush}"/>
                                        <TextBlock Text=" / " FontSize="13" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                                        <TextBlock Text="{Binding Monitor.MemTotal, StringFormat='{}{0:0.0} GB'}" FontSize="13" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <ProgressBar Value="{Binding Monitor.RamUsage}" Minimum="0" Maximum="100" Height="6" Foreground="{DynamicResource LuminaDangerBrush}"/>

                                <!-- Details 2x2 Grid -->
                                <Border Background="{DynamicResource LuminaSurfaceBrush}" CornerRadius="{DynamicResource AppRadiusSm}" Padding="12,10">
                                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, 8, Auto">
                                        <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto, *">
                                            <TextBlock Text="{c:Localize UsedMemory}" Classes="SubLabel"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Monitor.MemUsed, StringFormat='{}{0:0.0} GB'}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto, *" Margin="12,0,0,0">
                                            <TextBlock Text="{c:Localize AvailableMemory}" Classes="SubLabel"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Monitor.MemFree, StringFormat='{}{0:0.0} GB'}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="Auto, *">
                                            <TextBlock Text="{c:Localize Cache}" Classes="SubLabel"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Monitor.MemCached, StringFormat='{}{0:0.0} GB'}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto, *" Margin="12,0,0,0">
                                            <TextBlock Text="{c:Localize BufferMemory}" Classes="SubLabel"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Monitor.MemBuffers, StringFormat='{}{0:0.0} GB'}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </lumina:LuminaCard>
                        
                        <!-- Swap Partition -->
                        <lumina:LuminaCard Classes="SidebarCard" Padding="14,12">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <avalonia:MaterialIcon Kind="SwapHorizontalBold" Width="16" Height="16" Foreground="{DynamicResource LuminaPrimaryBrush}"/>
                                        <TextBlock Text="{c:Localize SwapPartition}" Classes="CardTitle"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Monitor.SwapUsed, StringFormat='{}{0:0.0} GB'}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text=" / " FontSize="12" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                                        <TextBlock Text="{Binding Monitor.SwapTotal, StringFormat='{}{0:0.0} GB'}" FontSize="12" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Value="{Binding Monitor.SwapUsed}" Maximum="{Binding Monitor.SwapTotal}" Height="6" Foreground="{DynamicResource LuminaPrimaryBrush}"/>
                            </StackPanel>
                        </lumina:LuminaCard>
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. DISK -->
                <ScrollViewer IsVisible="{Binding Monitor.IsTabDisk, FallbackValue=False, TargetNullValue=False}" Padding="10,4,10,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*, 10, *" RowDefinitions="Auto, 10, Auto">
                            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource LuminaBackgroundBrush}"
                                    BorderBrush="{DynamicResource LuminaBorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource AppRadiusMd}" Padding="12,10">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{c:Localize ReadSpeed}" Classes="SubLabel"/>
                                    <TextBlock Text="{Binding Monitor.DiskReadSpeed}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource LuminaSuccessBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource LuminaBackgroundBrush}"
                                    BorderBrush="{DynamicResource LuminaBorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource AppRadiusMd}" Padding="12,10">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{c:Localize WriteSpeed}" Classes="SubLabel"/>
                                    <TextBlock Text="{Binding Monitor.DiskWriteSpeed}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource LuminaCyanBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource LuminaBackgroundBrush}"
                                    BorderBrush="{DynamicResource LuminaBorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource AppRadiusMd}" Padding="12,10">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{c:Localize ReadIOPS}" Classes="SubLabel"/>
                                    <TextBlock Text="{Binding Monitor.DiskReadIops}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Background="{DynamicResource LuminaBackgroundBrush}"
                                    BorderBrush="{DynamicResource LuminaBorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource AppRadiusMd}" Padding="12,10">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{c:Localize WriteIOPS}" Classes="SubLabel"/>
                                    <TextBlock Text="{Binding Monitor.DiskWriteIops}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <!-- Storage Mount Point -->
                        <lumina:LuminaCard Classes="SidebarCard" Padding="14,12">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <avalonia:MaterialIcon Kind="Harddisk" Width="18" Height="18" Foreground="{DynamicResource LuminaWarningBrush}"/>
                                        <TextBlock Text="{Binding Monitor.DiskPath}" FontWeight="Bold" FontSize="14"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Monitor.DiskUsage, StringFormat='{}{0:0.0}%'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource LuminaWarningBrush}"/>
                                </Grid>
                                <ProgressBar Value="{Binding Monitor.DiskUsage}" Minimum="0" Maximum="100" Height="6" Foreground="{DynamicResource LuminaWarningBrush}"/>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="{c:Localize UsedCapacityTotalCapacity}" Classes="SubLabel"/>
                                    <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold">
                                        <Run Text="{Binding Monitor.DiskUsedBytes, StringFormat='{}{0:0.0} GB'}"/><Run Text=" / "/><Run Text="{Binding Monitor.DiskTotal, StringFormat='{}{0:0.0} GB'}"/>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </lumina:LuminaCard>
                    </StackPanel>
                </ScrollViewer>

                <!-- 5. NETWORK -->
                <ScrollViewer IsVisible="{Binding Monitor.IsTabNetwork, FallbackValue=False, TargetNullValue=False}" Padding="10,4,10,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*, 10, *" RowDefinitions="Auto, 10, Auto">
                            <!-- Download -->
                            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource LuminaBackgroundBrush}"
                                    BorderBrush="{DynamicResource LuminaBorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource AppRadiusMd}" Padding="12,10">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <avalonia:MaterialIcon Kind="ArrowDown" Width="16" Height="16" Foreground="{DynamicResource LuminaSuccessBrush}"/>
                                        <TextBlock Text="{c:Localize Download}" Classes="MetricLabel"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Monitor.NetworkDown}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource LuminaSuccessBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <!-- Upload -->
                            <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource LuminaBackgroundBrush}"
                                    BorderBrush="{DynamicResource LuminaBorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource AppRadiusMd}" Padding="12,10">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <avalonia:MaterialIcon Kind="ArrowUp" Width="16" Height="16" Foreground="{DynamicResource LuminaCyanBrush}"/>
                                        <TextBlock Text="{c:Localize Upload}" Classes="MetricLabel"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Monitor.NetworkUp}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource LuminaCyanBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <!-- Latency -->
                            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource LuminaBackgroundBrush}"
                                    BorderBrush="{DynamicResource LuminaBorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource AppRadiusMd}" Padding="12,10">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <avalonia:MaterialIcon Kind="TimerOutline" Width="16" Height="16" Foreground="{DynamicResource LuminaPrimaryBrush}"/>
                                        <TextBlock Text="{c:Localize Latency}" Classes="MetricLabel"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Monitor.PingStatus}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource LuminaPrimaryBrush}"/>
                                </Grid>
                            </Border>
                        </Grid>
                        
                        <!-- Stats -->
                        <lumina:LuminaCard Classes="SidebarCard" Padding="14,12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{c:Localize Statistics}" Classes="CardTitle"/>
                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, 8, Auto">
                                    <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto, *">
                                        <TextBlock Text="{c:Localize TcpConnections}" Classes="SubLabel"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Monitor.TcpConnections}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto, *" Margin="12,0,0,0">
                                        <TextBlock Text="{c:Localize TotalPackets}" Classes="SubLabel"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Monitor.TotalPacketsRecv}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="Auto, *">
                                        <TextBlock Text="{c:Localize TotalReceived}" Classes="SubLabel"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Monitor.NetTotalRecv}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto, *" Margin="12,0,0,0">
                                        <TextBlock Text="{c:Localize TotalSent}" Classes="SubLabel"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Monitor.NetTotalSent}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </lumina:LuminaCard>
                        
                        <!-- Listening Ports -->
                        <lumina:LuminaCard Classes="SidebarCard" Padding="14,12">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <avalonia:MaterialIcon Kind="LanConnect" Width="16" Height="16" Foreground="{DynamicResource LuminaSuccessBrush}"/>
                                    <TextBlock Text="{c:Localize ListeningPorts}" Classes="CardTitle"/>
                                </StackPanel>
                                <!-- Table Header -->
                                <Border Background="{DynamicResource LuminaSurfaceBrush}" CornerRadius="{DynamicResource AppRadiusSm}" Padding="8,6">
                                    <Grid ColumnDefinitions="65, *, 90">
                                        <TextBlock Grid.Column="0" Text="{c:Localize PortColumn}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{c:Localize Address}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{c:Localize Process}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource LuminaTextTertiaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Monitor.ListeningPorts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,4" Background="Transparent" CornerRadius="{DynamicResource AppRadiusSm}">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{c:Localize CopyPort}"
                                                                  Command="{Binding #SidebarRoot.DataContext.Monitor.CopyTextCommand}"
                                                                  CommandParameter="{Binding Display}">
                                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="Ethernet"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{c:Localize CopyAddress}"
                                                                  Command="{Binding #SidebarRoot.DataContext.Monitor.CopyTextCommand}"
                                                                  CommandParameter="{Binding LocalAddress}">
                                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="IpNetworkOutline"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{c:Localize CopyProcessName}"
                                                                  Command="{Binding #SidebarRoot.DataContext.Monitor.CopyTextCommand}"
                                                                  CommandParameter="{Binding Process}">
                                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="FormatLetterCase"/></MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid ColumnDefinitions="65, *, 90">
                                                    <TextBlock Grid.Column="0" Text="{Binding Display}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LuminaSuccessBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding LocalAddress}" FontSize="11" Foreground="{DynamicResource LuminaTextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Process}" FontSize="11" Foreground="{DynamicResource LuminaTextPrimaryBrush}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip.Tip="{Binding Process}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </lumina:LuminaCard>
                    </StackPanel>
                </ScrollViewer>

                <!-- 6. SFTP (SSH sessions only) -->
                <Grid IsVisible="{Binding Monitor.IsTabSftp, FallbackValue=False, TargetNullValue=False}">
                    <Grid IsVisible="{Binding Sftp, Converter={x:Static ObjectConverters.IsNotNull}}"
                          RowDefinitions="Auto, 10, Auto, 10, *" Margin="14">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                            <TextBlock Grid.Column="0" Text="{c:Localize FileManager}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                <Button Classes="Ghost IconOnly Compact" Command="{Binding Sftp.SyncWithTerminalCommand}" ToolTip.Tip="{c:Localize SyncTerminalPath}" Padding="6">
                                    <avalonia:MaterialIcon Kind="CompassOutline" Width="15" Height="15"/>
                                </Button>
                                <Button Classes="Ghost IconOnly Compact" Command="{Binding Sftp.NavigateUpCommand}" ToolTip.Tip="{c:Localize ParentDirectory}" Padding="6">
                                    <avalonia:MaterialIcon Kind="ArrowUp" Width="15" Height="15"/>
                                </Button>
                                <Button Classes="Ghost IconOnly Compact" Command="{Binding Sftp.RefreshFilesCommand}" ToolTip.Tip="{c:Localize Refresh}" Padding="6">
                                    <avalonia:MaterialIcon Kind="Refresh" Width="15" Height="15"/>
                                </Button>
                                <Button Classes="Ghost IconOnly Compact" Command="{Binding Sftp.CreateFolderCommand}" ToolTip.Tip="{c:Localize NewFolder}" Padding="6">
                                    <avalonia:MaterialIcon Kind="FolderPlus" Width="15" Height="15"/>
                                </Button>
                                <Button Classes="Ghost IconOnly Compact" Command="{Binding Sftp.CreateFileCommand}" ToolTip.Tip="{c:Localize NewFile}" Padding="6">
                                    <avalonia:MaterialIcon Kind="FilePlus" Width="15" Height="15"/>
                                </Button>
                                <Button Classes="Ghost IconOnly Compact" Command="{Binding Sftp.RenameSelectedCommand}" ToolTip.Tip="{c:Localize RenameItem}" Padding="6"
                                        IsEnabled="{Binding Sftp.SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <avalonia:MaterialIcon Kind="Pencil" Width="15" Height="15"/>
                                </Button>
                                <Button Classes="Ghost IconOnly Compact" Command="{Binding Sftp.DeleteSelectedCommand}" ToolTip.Tip="{c:Localize DeleteConfirmTitle}" Padding="6"
                                        IsEnabled="{Binding Sftp.SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <avalonia:MaterialIcon Kind="Delete" Width="15" Height="15" Foreground="{DynamicResource LuminaDangerBrush}"/>
                                </Button>
                                <Button Classes="Ghost IconOnly Compact" ToolTip.Tip="{c:Localize Upload}" Padding="6">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <MenuItem Header="{c:Localize UploadFile}" Command="{Binding Sftp.UploadFileCommand}">
                                                <MenuItem.Icon><avalonia:MaterialIcon Kind="FileOutline"/></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{c:Localize UploadFolder}" Command="{Binding Sftp.UploadFolderCommand}">
                                                <MenuItem.Icon><avalonia:MaterialIcon Kind="FolderOutline"/></MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="{c:Localize CompressedUpload}">
                                                <MenuItem.Icon><avalonia:MaterialIcon Kind="ArchiveOutline"/></MenuItem.Icon>
                                                <MenuItem Header="{c:Localize CompressedUploadFileTar}" Command="{Binding Sftp.UploadFileCompressedTarCommand}">
                                                    <MenuItem.Icon><avalonia:MaterialIcon Kind="ArchiveOutline"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{c:Localize CompressedUploadFileZip}" Command="{Binding Sftp.UploadFileCompressedZipCommand}">
                                                    <MenuItem.Icon><avalonia:MaterialIcon Kind="FolderZipOutline"/></MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="{c:Localize CompressedUploadFolderTar}" Command="{Binding Sftp.UploadFolderCompressedTarCommand}">
                                                    <MenuItem.Icon><avalonia:MaterialIcon Kind="ArchiveOutline"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{c:Localize CompressedUploadFolderZip}" Command="{Binding Sftp.UploadFolderCompressedZipCommand}">
                                                    <MenuItem.Icon><avalonia:MaterialIcon Kind="FolderZipOutline"/></MenuItem.Icon>
                                                </MenuItem>
                                            </MenuItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <avalonia:MaterialIcon Kind="Upload" Width="15" Height="15"/>
                                </Button>
                                <Button Classes="Ghost IconOnly Compact" Command="{Binding Sftp.DownloadFileCommand}" ToolTip.Tip="{c:Localize Download}" Padding="6"
                                        IsEnabled="{Binding Sftp.SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <avalonia:MaterialIcon Kind="Download" Width="15" Height="15"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <TextBox Grid.Row="2" Text="{Binding Sftp.CurrentPath, Mode=TwoWay}" Classes="Small Rounded" KeyDown="SftpPathTextBox_KeyDown"/>

                        <Grid Grid.Row="4" RowDefinitions="Auto, *, Auto">
                            <Border IsVisible="{Binding Sftp.HasError}"
                                    Background="{DynamicResource LuminaDangerBgBrush}"
                                    CornerRadius="{DynamicResource AppRadiusSm}"
                                    Padding="10,7" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <avalonia:MaterialIcon Kind="AlertCircleOutline" Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource LuminaDangerBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Sftp.ErrorMessage}" TextWrapping="Wrap" FontSize="12" Margin="8,0"
                                               Foreground="{DynamicResource LuminaDangerBrush}"/>
                                    <Button Grid.Column="2" Classes="Ghost IconOnly Compact" Command="{Binding Sftp.DismissErrorCommand}" VerticalAlignment="Top">
                                        <avalonia:MaterialIcon Kind="Close" Width="13" Height="13" Foreground="{DynamicResource LuminaDangerBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <ListBox x:Name="SftpFileList" Grid.Row="1" ItemsSource="{Binding Sftp.Files}" SelectedItem="{Binding Sftp.SelectedFile, Mode=TwoWay}"
                                     Background="Transparent" Padding="0" DoubleTapped="SftpFileList_DoubleTapped"
                                     ToolTip.Tip="{c:Localize SftpDropHint}">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{c:Localize SyncTerminalPath}"
                                                  Command="{Binding Sftp.SyncWithTerminalCommand}">
                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="CompassOutline"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{c:Localize OpenCurrentPathInTerminal}"
                                                  Command="{Binding Sftp.OpenCurrentPathInTerminalCommand}">
                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="Console"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="{c:Localize NewFolder}"
                                                  Command="{Binding Sftp.CreateFolderCommand}">
                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="FolderPlus"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{c:Localize NewFile}"
                                                  Command="{Binding Sftp.CreateFileCommand}">
                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="FilePlus"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{c:Localize Upload}">
                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="Upload"/></MenuItem.Icon>
                                            <MenuItem Header="{c:Localize UploadFile}" Command="{Binding Sftp.UploadFileCommand}">
                                                <MenuItem.Icon><avalonia:MaterialIcon Kind="FileOutline"/></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{c:Localize UploadFolder}" Command="{Binding Sftp.UploadFolderCommand}">
                                                <MenuItem.Icon><avalonia:MaterialIcon Kind="FolderOutline"/></MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="{c:Localize CompressedUpload}">
                                                <MenuItem.Icon><avalonia:MaterialIcon Kind="ArchiveOutline"/></MenuItem.Icon>
                                                <MenuItem Header="{c:Localize CompressedUploadFileTar}" Command="{Binding Sftp.UploadFileCompressedTarCommand}">
                                                    <MenuItem.Icon><avalonia:MaterialIcon Kind="ArchiveOutline"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{c:Localize CompressedUploadFileZip}" Command="{Binding Sftp.UploadFileCompressedZipCommand}">
                                                    <MenuItem.Icon><avalonia:MaterialIcon Kind="FolderZipOutline"/></MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="{c:Localize CompressedUploadFolderTar}" Command="{Binding Sftp.UploadFolderCompressedTarCommand}">
                                                    <MenuItem.Icon><avalonia:MaterialIcon Kind="ArchiveOutline"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{c:Localize CompressedUploadFolderZip}" Command="{Binding Sftp.UploadFolderCompressedZipCommand}">
                                                    <MenuItem.Icon><avalonia:MaterialIcon Kind="FolderZipOutline"/></MenuItem.Icon>
                                                </MenuItem>
                                            </MenuItem>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="{c:Localize CopyCurrentPath}"
                                                  Command="{Binding Sftp.CopyCurrentPathCommand}">
                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="ContentCopy"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{c:Localize ParentDirectory}"
                                                  Command="{Binding Sftp.NavigateUpCommand}">
                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="ArrowUp"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{c:Localize Refresh}"
                                                  Command="{Binding Sftp.RefreshFilesCommand}">
                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="Refresh"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto, *, Auto" Height="32" Background="Transparent">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{c:Localize OpenFolder}"
                                                              Command="{Binding #SidebarRoot.DataContext.Sftp.NavigateCommand}"
                                                              CommandParameter="{Binding}"
                                                              IsVisible="{Binding IsDirectory}">
                                                        <MenuItem.Icon><avalonia:MaterialIcon Kind="FolderOpen"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{c:Localize OpenInTerminal}"
                                                              Command="{Binding #SidebarRoot.DataContext.Sftp.OpenInTerminalCommand}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon><avalonia:MaterialIcon Kind="Console"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <!-- Unified Download & Compressed Download for both Files and Folders -->
                                                    <MenuItem Header="{c:Localize Download}"
                                                              Command="{Binding #SidebarRoot.DataContext.Sftp.DownloadItemCommand}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon><avalonia:MaterialIcon Kind="Download"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{c:Localize CompressedDownload}">
                                                        <MenuItem.Icon><avalonia:MaterialIcon Kind="ArchiveOutline"/></MenuItem.Icon>
                                                        <MenuItem Header="{c:Localize CompressedDownloadTar}"
                                                                  Command="{Binding #SidebarRoot.DataContext.Sftp.DownloadItemCompressedTarCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="ArchiveOutline"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{c:Localize CompressedDownloadZip}"
                                                                  Command="{Binding #SidebarRoot.DataContext.Sftp.DownloadItemCompressedZipCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="FolderZipOutline"/></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{c:Localize DownloadFolderStandard}"
                                                                  Command="{Binding #SidebarRoot.DataContext.Sftp.DownloadFolderStandardCommand}"
                                                                  CommandParameter="{Binding}"
                                                                  IsVisible="{Binding IsDirectory}">
                                                            <MenuItem.Icon><avalonia:MaterialIcon Kind="FolderSyncOutline"/></MenuItem.Icon>
                                                        </MenuItem>
                                                    </MenuItem>
                                                    <MenuItem Header="{c:Localize RenameItem}"
                                                              Command="{Binding #SidebarRoot.DataContext.Sftp.RenameSelectedCommand}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon><avalonia:MaterialIcon Kind="Pencil"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{c:Localize CopyPath}"
                                                              Command="{Binding #SidebarRoot.DataContext.Sftp.CopyPathCommand}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon><avalonia:MaterialIcon Kind="ContentCopy"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{c:Localize CopyName}"
                                                              Command="{Binding #SidebarRoot.DataContext.Sftp.CopyNameCommand}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon><avalonia:MaterialIcon Kind="FormatLetterCase"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <MenuItem Header="{c:Localize DeleteConfirmTitle}"
                                                              Command="{Binding #SidebarRoot.DataContext.Sftp.DeleteSelectedCommand}"
                                                              CommandParameter="{Binding}"
                                                              Foreground="{DynamicResource LuminaDangerBrush}">
                                                        <MenuItem.Icon><avalonia:MaterialIcon Kind="Delete" Foreground="{DynamicResource LuminaDangerBrush}"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <MenuItem Header="{c:Localize Refresh}"
                                                              Command="{Binding #SidebarRoot.DataContext.Sftp.RefreshFilesCommand}">
                                                        <MenuItem.Icon><avalonia:MaterialIcon Kind="Refresh"/></MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <avalonia:MaterialIcon Kind="{Binding Icon}" Width="16" Height="16" Opacity="0.8" Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource LuminaPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DisplaySize}" FontSize="11" Opacity="0.5" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Top loading indicator line (sleek, non-intrusive 2px accent) -->
                            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" VerticalAlignment="Top"
                                         Foreground="{DynamicResource LuminaPrimaryBrush}"
                                         Background="Transparent"
                                         IsVisible="{Binding Sftp.IsLoading}"/>

                            <!-- Center loading spinner when directory is empty -->
                            <lumina:LuminaLoading Grid.Row="1" Size="32" StrokeThickness="3"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsVisible="{Binding Sftp.IsLoadingAndEmpty}"/>

                            <!-- Active Transfers Notification Bar (Non-blocking) -->
                            <Border Grid.Row="2"
                                    IsVisible="{Binding Sftp.HasActiveTransfers}"
                                    Background="{DynamicResource LuminaSurfaceBrush}"
                                    BorderBrush="{DynamicResource LuminaBorderSubtleBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="10,7"
                                    Margin="0,4,0,0"
                                    CornerRadius="{DynamicResource AppRadiusSm}">
                                <Grid RowDefinitions="Auto, Auto">
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                                        <avalonia:MaterialIcon Kind="SwapVertical" Width="14" Height="14"
                                                               Foreground="{DynamicResource LuminaPrimaryBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Sftp.ActiveTransferSummary}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource LuminaTextSecondaryBrush}"/>
                                        <Button Grid.Column="2" Classes="Ghost Compact"
                                                Command="{Binding Sftp.NavigateToTransferCommand}"
                                                Padding="6,2">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{c:Localize ViewInTransferCenter}" FontSize="11" Foreground="{DynamicResource LuminaPrimaryBrush}"/>
                                                <avalonia:MaterialIcon Kind="ChevronRight" Width="12" Height="12" Foreground="{DynamicResource LuminaPrimaryBrush}"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <ProgressBar Grid.Row="1" Height="3" Margin="0,5,0,0"
                                                 Value="{Binding Sftp.OverallTransferProgress}"
                                                 IsIndeterminate="{Binding Sftp.OverallTransferIndeterminate}"
                                                 CornerRadius="1.5"
                                                 Foreground="{DynamicResource LuminaPrimaryBrush}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Non-SSH Session Placeholder -->
            <Grid RowDefinitions="Auto, *" IsVisible="{Binding !IsSshSession}">
                <Border Margin="10,10,10,6" Padding="3">
                    <Button HorizontalAlignment="Right" Command="{Binding ToggleSftpCommand}" Classes="Ghost IconOnly Compact" Width="28" Height="28" ToolTip.Tip="{c:Localize Close}">
                        <avalonia:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource LuminaTextTertiaryBrush}"/>
                    </Button>
                </Border>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="24">
                    <Border Width="64" Height="64" CornerRadius="{DynamicResource AppRadiusPill}"
                            Background="{DynamicResource LuminaPrimaryBgBrush}" HorizontalAlignment="Center">
                        <avalonia:MaterialIcon Kind="ServerNetworkOff" Width="32" Height="32" Foreground="{DynamicResource LuminaPrimaryBrush}"/>
                    </Border>
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="{c:Localize SidebarSshOnlyTitle}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource LuminaTextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{c:Localize SidebarSshOnlyDesc}" FontSize="12"
                                   Foreground="{DynamicResource LuminaTextSecondaryBrush}" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="280" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </lumina:LuminaCard>
</UserControl>